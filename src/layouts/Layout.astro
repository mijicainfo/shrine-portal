---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { gaMeasurementId } from '../data/analytics';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const lang = Astro.currentLocale === 'en' ? 'en' : 'ja';

const defaultDescription = lang === 'en'
  ? 'A guide to shrines across Japan — history, access, and goshuin info, along with nearby accommodation, written for first-time visitors.'
  : '日本全国の神社を紹介するポータルサイト。由緒、アクセス、御朱印情報まで、参拝の初心者にもわかりやすくお届けします。';

const titleSuffix = lang === 'en'
  ? 'Shrine The Pantheon — Japan Shrine Guide & Nearby Stays'
  : '日本の神社情報・近隣宿泊施設なども紹介する神社 The Pantheon';

const siteName = lang === 'en' ? 'Shrine The Pantheon' : '神社 The Pantheon';

const { title, description = defaultDescription, image = '/og-image.png' } = Astro.props;
const fullTitle = `${title}${lang === 'en' ? ' | ' : '｜'}${titleSuffix}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700;900&family=Yomogi&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@shrine2026" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col font-sans-jp">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
