---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guidesKo')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout
  title="특집 기사"
  description="추천 신사부터 신도 관습에 관한 실용적인 정보까지, 주제별로 정리한 특집 기사 목록입니다."
>
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">특집 기사</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        신사 참배에 도움이 되는 정보를 주제별로 소개합니다.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {guides.map((guide) => (
        <a
          href={`/ko/guides/${guide.id}/`}
          class="group block rounded-2xl border border-shrine-gold/25 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 class="font-serif-jp text-lg font-bold text-shrine-ink group-hover:text-shrine-vermillion-dark">
            {guide.data.title}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">{guide.data.description}</p>
          <p class="mt-3 text-xs text-shrine-vermillion">
            {guide.data.entries.length > 0 ? `신사 ${guide.data.entries.length}곳 소개` : '더 보기'} →
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>
