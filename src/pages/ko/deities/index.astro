---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { deityInsightsKo } from '../../../data/deityInsights.ko';

const shrines = (await getCollection('shrinesKo')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="신 가이드" description="일본 각지 신사에 모셔진 신들을 소개합니다 — 신화 속 역할과 함께 전해지는 신주(神呪)까지 함께 알아봅니다.">
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">신 가이드</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        각 신사에 모셔진 신(카미)들을 자세히 살펴봅니다 — 그 유래와 역할을 소개합니다.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="rounded-2xl border border-shrine-gold/25 bg-white p-6">
      <h2 class="font-serif-jp text-base font-bold text-shrine-ink">신주(神呪)에 대하여</h2>
      <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
        "신곤(진언)"이라는 말은 불교(특히 진언종)에서 비롯된 것으로, 엄밀히 말하면 신도의 신에게는 해당되지 않습니다. 다만 아마테라스 오미카미의 "도코토노카미노쥬"나 하치만 오카미의 "나무 하치만 다이보사쓰"처럼, 역사적으로 전해 내려온 신주를 가진 신들도 있습니다. 그런 신주가 있는 경우에는 그 유래와 함께 소개합니다. 특정 신주가 없는 신에 대해서는 진심을 담아 그 이름을 조용히 부르는 것이 일반적인 관례입니다.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {shrines.map((shrine) => {
        const insight = deityInsightsKo[shrine.id] ?? {
          category: '모시는 신',
          description: `${shrine.data.name}의 유래와 모시는 신에 대한 자세한 내용은 해당 신사 페이지에서 확인하실 수 있습니다.`,
        };
        return (
          <div class="overflow-hidden rounded-2xl border border-shrine-gold/25 bg-white shadow-sm">
            {shrine.data.image && (
              <div class="h-40 overflow-hidden">
                <Image
                  src={shrine.data.image}
                  alt={shrine.data.name}
                  width={640}
                  height={360}
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="p-6">
              <p class="text-xs font-medium tracking-wide text-shrine-vermillion">{insight.category}</p>
              <h2 class="mt-1 font-serif-jp text-lg font-bold text-shrine-ink">
                {shrine.data.deities.join(', ')}
              </h2>
              <p class="mt-1 text-xs text-shrine-ink-soft">
                모셔진 곳: <a href={`/ko/shrines/${shrine.id}/`} class="text-shrine-vermillion underline hover:text-shrine-vermillion-dark">{shrine.data.name}</a>
              </p>
              <p class="mt-3 text-sm leading-relaxed text-shrine-ink-soft">{insight.description}</p>

              {insight.chant && (
                <div class="mt-4 rounded-2xl bg-shrine-vermillion-light p-4">
                  <p class="text-xs font-bold text-shrine-vermillion-dark">{insight.chant.title}</p>
                  <p class="mt-1 font-serif-jp text-base font-bold text-shrine-ink">{insight.chant.text}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-shrine-ink-soft">{insight.chant.note}</p>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
