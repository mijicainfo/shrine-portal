---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { deityInsightsEn } from '../../../data/deityInsights.en';

const shrines = (await getCollection('shrinesEn')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Guide to the Kami" description="An introduction to the kami enshrined at shrines across Japan — their mythological roles and any traditional chants associated with them.">
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">Guide to the Kami</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        A closer look at the kami (deities) enshrined at each shrine — their origins and their roles.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="rounded-2xl border border-shrine-gold/25 bg-white p-6">
      <h2 class="font-serif-jp text-base font-bold text-shrine-ink">About the Chants</h2>
      <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
        The term "shingon" (mantra) comes from Buddhism (specifically Shingon Buddhism) and, strictly speaking, does not apply to Shinto deities. That said, some kami do have chants that have been passed down historically — such as Amaterasu Omikami's "Tokoto no Kami no Ju" or Hachiman Okami's "Namu Hachiman Daibosatsu." Where such a chant exists, we introduce it along with its background. For kami without a specific chant, the general custom is simply to speak the deity's name with a sincere heart.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {shrines.map((shrine) => {
        const insight = deityInsightsEn[shrine.id] ?? {
          category: 'Enshrined Kami',
          description: `A detailed look at ${shrine.data.name}'s history and enshrined kami is available on the shrine's own page.`,
        };
        return (
          <div class="overflow-hidden rounded-2xl border border-shrine-gold/25 bg-white shadow-sm">
            {shrine.data.image && (
              <div class="h-40 overflow-hidden">
                <Image
                  src={shrine.data.image}
                  alt={shrine.data.name}
                  width={640}
                  height={360}
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="p-6">
              <p class="text-xs font-medium tracking-wide text-shrine-vermillion">{insight.category}</p>
              <h2 class="mt-1 font-serif-jp text-lg font-bold text-shrine-ink">
                {shrine.data.deities.join(', ')}
              </h2>
              <p class="mt-1 text-xs text-shrine-ink-soft">
                Enshrined at: <a href={`/en/shrines/${shrine.id}/`} class="text-shrine-vermillion underline hover:text-shrine-vermillion-dark">{shrine.data.name}</a>
              </p>
              <p class="mt-3 text-sm leading-relaxed text-shrine-ink-soft">{insight.description}</p>

              {insight.chant && (
                <div class="mt-4 rounded-2xl bg-shrine-vermillion-light p-4">
                  <p class="text-xs font-bold text-shrine-vermillion-dark">{insight.chant.title}</p>
                  <p class="mt-1 font-serif-jp text-base font-bold text-shrine-ink">{insight.chant.text}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-shrine-ink-soft">{insight.chant.note}</p>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
