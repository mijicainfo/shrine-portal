---
import Layout from '../../../layouts/Layout.astro';
import { contactFormUrl } from '../../../data/contact';
---

<Layout title="Contact" description="Report an error or outdated information, or send us feedback and requests.">
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">Contact</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        Let us know about any errors, or share your feedback and thoughts.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <div class="rounded-2xl border border-shrine-gold/25 bg-white p-8">
      <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">Spot something that needs correcting?</h2>
      <p class="mt-3 text-sm leading-relaxed text-shrine-ink-soft">
        Shrine history, access information, and visiting hours can change over time. If you notice an error, outdated information, or anything that should be corrected, please let us know below.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-shrine-ink-soft">
        It helps to mention which page and which section you're referring to. Requests for shrines you'd like to see added, and general feedback about the site, are welcome too.
      </p>

      {contactFormUrl ? (
        <a
          href={contactFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 flex items-center justify-center gap-2 rounded-full bg-shrine-vermillion px-6 py-3 text-sm font-bold text-white transition hover:bg-shrine-vermillion-dark"
        >
          Open Contact Form ↗
        </a>
      ) : (
        <p class="mt-6 rounded-2xl bg-shrine-paper-dark px-6 py-4 text-center text-sm text-shrine-ink-soft">
          The contact form is being set up. Please check back soon.
        </p>
      )}
    </div>
  </section>
</Layout>
