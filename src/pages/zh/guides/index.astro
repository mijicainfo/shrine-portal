---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guidesZh')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout
  title="精選文章"
  description="從締結良緣、金運亨通的推薦神社，到神棚的供奉方式，依主題彙整的專題文章一覽。"
>
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">精選文章</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        依主題為您彙整參拜神社的實用資訊。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {guides.map((guide) => (
        <a
          href={`/zh/guides/${guide.id}/`}
          class="group block rounded-2xl border border-shrine-gold/25 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 class="font-serif-jp text-lg font-bold text-shrine-ink group-hover:text-shrine-vermillion-dark">
            {guide.data.title}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">{guide.data.description}</p>
          <p class="mt-3 text-xs text-shrine-vermillion">
            {guide.data.entries.length > 0 ? `精選${guide.data.entries.length}間神社` : '閱讀更多'} →
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>
