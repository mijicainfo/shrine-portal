---
import Layout from '../../../layouts/Layout.astro';
import ShrineCard from '../../../components/ShrineCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { buildItemListStructuredData } from '../../../lib/seo';

export async function getStaticPaths() {
  const guides = await getCollection('guidesZh');
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { data } = guide;

const entries = await Promise.all(
  data.entries.map(async (entry) => {
    const shrine = await getEntry('shrinesZh', entry.shrineId);
    return { entry, shrine };
  }),
);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const structuredData = buildItemListStructuredData(
  data.title,
  entries
    .filter(({ shrine }) => shrine)
    .map(({ shrine }) => ({
      name: shrine!.data.name,
      url: new URL(`/zh/shrines/${shrine!.id}/`, Astro.site).toString(),
    })),
);
---

<Layout title={data.title} description={data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <p class="text-xs text-shrine-paper/60">
        <a href="/zh/guides/" class="hover:underline">精選文章</a> / {data.title}
      </p>
      <h1 class="mt-2 font-serif-jp text-2xl font-bold sm:text-3xl">{data.title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-shrine-paper/80">{data.description}</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <ol class="space-y-10">
      {entries.map(({ entry, shrine }, i) => shrine && (
        <li class="border-b border-shrine-gold/15 pb-10 last:border-0 last:pb-0">
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-shrine-vermillion font-serif-jp text-base font-bold text-white">
              {i + 1}
            </span>
            <div class="min-w-0 flex-1">
              <p class="mb-4 text-sm leading-relaxed text-shrine-ink-soft">{entry.note}</p>
              <div class="max-w-sm">
                <ShrineCard shrine={shrine} />
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Layout>
