---
import Layout from '../../../layouts/Layout.astro';
import { glossaryTermsZh, glossaryCategoriesZh } from '../../../data/glossary.zh';
---

<Layout title="用語小百科" description="參拜神社時常見的用語小辭典——鳥居、御朱印、八百萬神明等，一次搞懂。">
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">用語集</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        參拜神社時會遇到的各種用語。了解它們的意思，能讓參拜體驗更加豐富有趣。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <input
      id="glossary-search"
      type="text"
      placeholder="搜尋用語（例如：鳥居、御朱印）"
      class="w-full rounded-full border border-shrine-gold/40 bg-white px-5 py-2.5 text-sm text-shrine-ink placeholder:text-shrine-ink-soft focus:outline-none focus:ring-2 focus:ring-shrine-vermillion"
    />

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="分類目錄">
      {glossaryCategoriesZh.map((category, i) => (
        <a
          href={`#glossary-category-${i}`}
          class="rounded-full border border-shrine-gold/30 bg-white px-3 py-1.5 text-xs text-shrine-ink-soft transition hover:border-shrine-vermillion hover:text-shrine-vermillion-dark"
        >
          {category}
        </a>
      ))}
    </nav>

    <div class="mt-8 space-y-10">
      {glossaryCategoriesZh.map((category, i) => (
        <div class="glossary-category">
          <h2 id={`glossary-category-${i}`} class="scroll-mt-24 font-serif-jp text-lg font-bold text-shrine-vermillion-dark">{category}</h2>
          <dl class="mt-4 divide-y divide-shrine-gold/15 rounded-2xl border border-shrine-gold/20 bg-white">
            {glossaryTermsZh
              .filter((t) => t.category === category)
              .map((t) => (
                <div class="glossary-item flex gap-4 p-5" data-term={`${t.term} ${t.reading} ${t.description}`}>
                  <span
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-shrine-vermillion-light text-xl"
                    aria-hidden="true"
                  >
                    {t.icon}
                  </span>
                  <div class="min-w-0 flex-1">
                    <dt class="flex flex-wrap items-baseline gap-2">
                      <span class="font-serif-jp text-base font-bold text-shrine-ink">{t.term}</span>
                      <span class="text-xs text-shrine-ink-soft">{t.reading}</span>
                    </dt>
                    <dd class="mt-1.5 text-sm leading-relaxed text-shrine-ink-soft">{t.description}</dd>
                  </div>
                </div>
              ))}
          </dl>
        </div>
      ))}
    </div>

    <p id="glossary-empty" class="mt-16 hidden text-center text-sm text-shrine-ink-soft">
      找不到符合的用語。
    </p>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('glossary-search') as HTMLInputElement;
  const categories = Array.from(document.querySelectorAll<HTMLElement>('.glossary-category'));
  const emptyMessage = document.getElementById('glossary-empty') as HTMLElement;

  function applyFilter() {
    const query = searchInput.value.trim().toLowerCase();
    let anyVisible = false;

    for (const category of categories) {
      const items = Array.from(category.querySelectorAll<HTMLElement>('.glossary-item'));
      let categoryHasVisible = false;

      for (const item of items) {
        const text = (item.dataset.term ?? '').toLowerCase();
        const visible = !query || text.includes(query);
        item.style.display = visible ? '' : 'none';
        if (visible) categoryHasVisible = true;
      }

      category.style.display = categoryHasVisible ? '' : 'none';
      if (categoryHasVisible) anyVisible = true;
    }

    emptyMessage.classList.toggle('hidden', anyVisible);
  }

  searchInput.addEventListener('input', applyFilter);
</script>
