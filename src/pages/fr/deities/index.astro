---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { deityInsightsFr } from '../../../data/deityInsights.fr';

const shrines = (await getCollection('shrinesFr')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Guide des Kami" description="Une introduction aux kami vénérés dans les sanctuaires à travers le Japon — leurs rôles mythologiques et les incantations traditionnelles qui leur sont associées.">
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">Guide des Kami</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        Un regard approfondi sur les kami (divinités) vénérés dans chaque sanctuaire — leurs origines et leurs rôles.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="rounded-2xl border border-shrine-gold/25 bg-white p-6">
      <h2 class="font-serif-jp text-base font-bold text-shrine-ink">À Propos des Incantations</h2>
      <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
        Le terme « shingon » (mantra) vient du bouddhisme (plus précisément du bouddhisme Shingon) et, à proprement parler, ne s'applique pas aux divinités shinto. Cela dit, certains kami possèdent des incantations transmises historiquement — comme le « Tokoto no Kami no Ju » d'Amaterasu Omikami ou le « Namu Hachiman Daibosatsu » de Hachiman Okami. Lorsqu'une telle incantation existe, nous la présentons avec son contexte. Pour les kami sans incantation spécifique, la coutume générale consiste simplement à prononcer le nom de la divinité avec un cœur sincère.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {shrines.map((shrine) => {
        const insight = deityInsightsFr[shrine.id] ?? {
          category: 'Kami Vénéré',
          description: `Un aperçu détaillé de l'histoire et du kami vénéré à ${shrine.data.name} est disponible sur la page du sanctuaire.`,
        };
        return (
          <div class="overflow-hidden rounded-2xl border border-shrine-gold/25 bg-white shadow-sm">
            {shrine.data.image && (
              <div class="h-40 overflow-hidden">
                <Image
                  src={shrine.data.image}
                  alt={shrine.data.name}
                  width={640}
                  height={360}
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="p-6">
              <p class="text-xs font-medium tracking-wide text-shrine-vermillion">{insight.category}</p>
              <h2 class="mt-1 font-serif-jp text-lg font-bold text-shrine-ink">
                {shrine.data.deities.join(', ')}
              </h2>
              <p class="mt-1 text-xs text-shrine-ink-soft">
                Vénéré à : <a href={`/fr/shrines/${shrine.id}/`} class="text-shrine-vermillion underline hover:text-shrine-vermillion-dark">{shrine.data.name}</a>
              </p>
              <p class="mt-3 text-sm leading-relaxed text-shrine-ink-soft">{insight.description}</p>

              {insight.chant && (
                <div class="mt-4 rounded-2xl bg-shrine-vermillion-light p-4">
                  <p class="text-xs font-bold text-shrine-vermillion-dark">{insight.chant.title}</p>
                  <p class="mt-1 font-serif-jp text-base font-bold text-shrine-ink">{insight.chant.text}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-shrine-ink-soft">{insight.chant.note}</p>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
