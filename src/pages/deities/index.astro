---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { deityInsights } from '../../data/deityInsights';

const shrines = (await getCollection('shrines')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="御祭神ガイド" description="全国の神社にお祀りされている御祭神について、神話上の役割や、伝えられている唱え言葉（となえことば）をご紹介します。">
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">御祭神ガイド</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        神社にお祀りされている神様（御祭神）について、その由来や役割を詳しくご紹介します。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="rounded-lg border border-shrine-gold/25 bg-white p-6">
      <h2 class="font-serif-jp text-base font-bold text-shrine-ink">「となえことば」について</h2>
      <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
        「真言（しんごん）」はもともと仏教（真言宗）の言葉で、厳密には神道の神様には存在しません。ただし、天照大御神の「十言の神呪」や八幡大神の「南無八幡大菩薩」のように、歴史的に唱え伝えられてきた言葉が実在する神様もいます。このページでは、そうした唱え言葉が伝わっている場合はその由来とともにご紹介し、特定の唱え言葉が伝わっていない神様については、ご神名を心を込めてお唱えするという一般的な作法をおすすめしています。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {shrines.map((shrine) => {
        // deityInsights.tsに個別データが用意されていない神社（新規追加分など）は、
        // 神社データから自動的に簡易カードを組み立てて表示する（掲載漏れを防ぐため）
        const insight = deityInsights[shrine.id] ?? {
          category: 'ご祭神',
          description: `${shrine.data.name}の由緒や御祭神についての詳しい解説は、神社の詳細ページでご紹介しています。`,
        };
        return (
          <div class="overflow-hidden rounded-lg border border-shrine-gold/25 bg-white shadow-sm">
            {shrine.data.image && (
              <div class="h-40 overflow-hidden">
                <Image
                  src={shrine.data.image}
                  alt={shrine.data.name}
                  width={640}
                  height={360}
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="p-6">
              <p class="text-xs font-medium tracking-wide text-shrine-vermillion">{insight.category}</p>
              <h2 class="mt-1 font-serif-jp text-lg font-bold text-shrine-ink">
                {shrine.data.deities.join('、')}
              </h2>
              <p class="mt-1 text-xs text-shrine-ink-soft">
                お祀りする神社: <a href={`/shrines/${shrine.id}/`} class="text-shrine-vermillion underline hover:text-shrine-vermillion-dark">{shrine.data.name}</a>
              </p>
              <p class="mt-3 text-sm leading-relaxed text-shrine-ink-soft">{insight.description}</p>

              {insight.chant && (
                <div class="mt-4 rounded-lg bg-shrine-vermillion-light p-4">
                  <p class="text-xs font-bold text-shrine-vermillion-dark">{insight.chant.title}</p>
                  <p class="mt-1 font-serif-jp text-base font-bold text-shrine-ink">{insight.chant.text}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-shrine-ink-soft">{insight.chant.note}</p>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
