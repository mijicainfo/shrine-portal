---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { deityInsightsEs } from '../../../data/deityInsights.es';

const shrines = (await getCollection('shrinesEs')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Guía de los Kami" description="Una introducción a los kami venerados en los santuarios de todo Japón — sus funciones mitológicas y los cánticos tradicionales asociados a ellos.">
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">Guía de los Kami</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        Una mirada más cercana a los kami (deidades) venerados en cada santuario — sus orígenes y sus funciones.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="rounded-2xl border border-shrine-gold/25 bg-white p-6">
      <h2 class="font-serif-jp text-base font-bold text-shrine-ink">Sobre los Cánticos</h2>
      <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
        El término "shingon" (mantra) proviene del budismo (concretamente del budismo Shingon) y, en sentido estricto, no se aplica a las deidades sintoístas. Aun así, algunos kami sí cuentan con cánticos transmitidos históricamente — como el "Tokoto no Kami no Ju" de Amaterasu Omikami o el "Namu Hachiman Daibosatsu" de Hachiman Okami. Cuando existe tal cántico, lo presentamos junto con su contexto. Para los kami sin un cántico específico, la costumbre general es simplemente pronunciar el nombre de la deidad con un corazón sincero.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {shrines.map((shrine) => {
        const insight = deityInsightsEs[shrine.id] ?? {
          category: 'Kami Venerado',
          description: `Puedes encontrar un análisis detallado de la historia y el kami venerado en ${shrine.data.name} en la propia página del santuario.`,
        };
        return (
          <div class="overflow-hidden rounded-2xl border border-shrine-gold/25 bg-white shadow-sm">
            {shrine.data.image && (
              <div class="h-40 overflow-hidden">
                <Image
                  src={shrine.data.image}
                  alt={shrine.data.name}
                  width={640}
                  height={360}
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="p-6">
              <p class="text-xs font-medium tracking-wide text-shrine-vermillion">{insight.category}</p>
              <h2 class="mt-1 font-serif-jp text-lg font-bold text-shrine-ink">
                {shrine.data.deities.join(', ')}
              </h2>
              <p class="mt-1 text-xs text-shrine-ink-soft">
                Venerado en: <a href={`/es/shrines/${shrine.id}/`} class="text-shrine-vermillion underline hover:text-shrine-vermillion-dark">{shrine.data.name}</a>
              </p>
              <p class="mt-3 text-sm leading-relaxed text-shrine-ink-soft">{insight.description}</p>

              {insight.chant && (
                <div class="mt-4 rounded-2xl bg-shrine-vermillion-light p-4">
                  <p class="text-xs font-bold text-shrine-vermillion-dark">{insight.chant.title}</p>
                  <p class="mt-1 font-serif-jp text-base font-bold text-shrine-ink">{insight.chant.text}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-shrine-ink-soft">{insight.chant.note}</p>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
