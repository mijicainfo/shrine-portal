---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guidesEs')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout
  title="Artículos Destacados"
  description="Recopilaciones temáticas de santuarios recomendados, desde el amor hasta la fortuna económica."
>
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-serif-jp text-2xl font-bold sm:text-3xl">Artículos Destacados</h1>
      <p class="mt-2 text-sm text-shrine-paper/75">
        Recopilaciones temáticas de santuarios recomendados.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {guides.map((guide) => (
        <a
          href={`/es/guides/${guide.id}/`}
          class="group block rounded-2xl border border-shrine-gold/25 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 class="font-serif-jp text-lg font-bold text-shrine-ink group-hover:text-shrine-vermillion-dark">
            {guide.data.title}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">{guide.data.description}</p>
          <p class="mt-3 text-xs text-shrine-vermillion">{guide.data.entries.length} santuarios destacados →</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
