---
// 「ページが見つかりません」用の 404 ページ。
// Cloudflare Pages などは、404.html が無いと、存在しない URL に対してトップページを 200 で返してしまう（検索エンジンに不利）。
// このページを置くことで、存在しない URL には 404 が返る。検索結果には出さない（noindex）。
import Layout from '../layouts/Layout.astro';

const langs = [
  { href: '/', label: '日本語', text: 'お探しのページは見つかりませんでした。', home: 'トップページへ' },
  { href: '/en/', label: 'English', text: 'The page you are looking for could not be found.', home: 'Go to the home page' },
  { href: '/zh/', label: '繁體中文', text: '找不到您要的頁面。', home: '前往首頁' },
  { href: '/es/', label: 'Español', text: 'No se ha encontrado la página que busca.', home: 'Ir a la página de inicio' },
  { href: '/fr/', label: 'Français', text: 'La page que vous recherchez est introuvable.', home: "Aller à la page d'accueil" },
  { href: '/ko/', label: '한국어', text: '찾으시는 페이지를 찾을 수 없습니다.', home: '홈페이지로 가기' },
];
---

<Layout noindex title="ページが見つかりません / Page not found" description="お探しのページは見つかりませんでした。">
  <section class="mx-auto max-w-2xl px-4 py-20 sm:px-6">
    <p class="font-serif-jp text-sm font-bold text-shrine-vermillion">404</p>
    <h1 class="mt-2 font-serif-jp text-2xl font-bold text-shrine-ink sm:text-3xl">ページが見つかりません</h1>
    <ul class="mt-8 space-y-4">
      {langs.map((l) => (
        <li class="rounded-2xl border border-shrine-gold/25 bg-white p-5">
          <p class="text-xs font-bold text-shrine-ink-soft">{l.label}</p>
          <p class="mt-1 text-sm text-shrine-ink">{l.text}</p>
          <a href={l.href} class="mt-2 inline-block text-sm text-shrine-vermillion-dark underline">{l.home}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
