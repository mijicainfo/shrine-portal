---
import { buildBookingSearchUrl, buildRakutenSearchUrl } from '../data/affiliate';

interface Props {
  shrineName: string;
  city: string;
  prefecture: string;
}

const { shrineName, city, prefecture } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : 'ja';
// Booking.comの検索は括弧つきの補足地名（例:「廿日市市（宮島）」）が入ると
// うまく場所を認識できないことがあるため、括弧書きの部分は取り除く
const cleanCity = city.replace(/[（(].*?[）)]/g, '').trim();
// Booking.comの地名データベースは「Mie Prefecture」のような「Prefecture」付きの
// 表記や、「Fushimi-ku」のような区レベルの地名を認識できず、検索結果ではなく
// トップページにリダイレクトされてしまうことが確認できたため、英語版の検索クエリ
// では市区町村（city）を含めず、神社名＋都道府県（Prefecture抜き）＋Japanのみを使う
const bookingPrefecture = prefecture.replace(/\s*Prefecture$/i, '');
const bookingQuery = lang === 'en'
  ? `${shrineName}, ${bookingPrefecture}, Japan`
  : `${shrineName} ${prefecture}${cleanCity}`;
const bookingUrl = buildBookingSearchUrl(bookingQuery);
// 楽天トラベルのキーワード検索は日本語専用で、英語のクエリでは
// 地名が一致せず常に検索結果0件になるため、英語版では表示しない
const rakutenUrl = buildRakutenSearchUrl(`${shrineName} ${prefecture}${cleanCity}`);
const t = {
  ja: {
    heading: '周辺の宿泊施設',
    body: '参拝とあわせて宿泊を計画したい方向けに、周辺のホテル・宿を検索できます。海外からの参拝者の方も、そのまま多言語で予約いただけます。',
    bookingSub: `${prefecture}${city}周辺の宿を検索（海外からの予約向け）`,
    rakutenLabel: '楽天トラベル',
    rakutenSub: `${prefecture}${city}周辺の宿を検索`,
    note: '※ 外部の予約サイトに移動します。',
  },
  en: {
    heading: 'Nearby Accommodation',
    body: 'Search hotels and inns near the shrine to plan your stay. Bookings are available in multiple languages for visitors from abroad.',
    bookingSub: `Search stays near ${city}, ${prefecture}`,
    rakutenLabel: 'Rakuten Travel',
    rakutenSub: `Search stays near ${city}, ${prefecture} (Japanese site)`,
    note: '※ Opens an external booking site.',
  },
}[lang];
---

<div class="rounded-2xl border border-shrine-gold/30 bg-white p-6 shadow-sm">
  <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">{t.heading}</h2>
  <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
    {t.body}
  </p>

  <div class="mt-4 space-y-2.5">
    <a
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="flex items-center justify-between gap-3 rounded-2xl border border-shrine-gold/30 bg-shrine-paper-dark px-4 py-3 text-sm text-shrine-ink transition hover:border-shrine-vermillion hover:text-shrine-vermillion"
    >
      <span>
        <span class="font-bold">Booking.com</span>
        <span class="block text-xs text-shrine-ink-soft">{t.bookingSub}</span>
      </span>
      <span aria-hidden="true">↗</span>
    </a>

    {lang === 'ja' && (
      <a
        href={rakutenUrl}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="flex items-center justify-between gap-3 rounded-2xl border border-shrine-gold/30 bg-shrine-paper-dark px-4 py-3 text-sm text-shrine-ink transition hover:border-shrine-vermillion hover:text-shrine-vermillion"
      >
        <span>
          <span class="font-bold">{t.rakutenLabel}</span>
          <span class="block text-xs text-shrine-ink-soft">{t.rakutenSub}</span>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>

  <p class="mt-3 text-[11px] leading-relaxed text-shrine-ink-soft/80">
    {t.note}
  </p>
</div>
