---
import { buildAccommodationBookingUrl, buildAccommodationRakutenUrl } from '../lib/accommodation';

interface Props {
  shrineName: string;
  city: string;
  prefecture: string;
  bookingCity?: string;
  bookingPrefecture?: string;
}

const { shrineName, city, prefecture, bookingCity, bookingPrefecture } = Astro.props;
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
// Booking.comの検索は括弧つきの補足地名（例:「廿日市市（宮島）」）が入ると
// うまく場所を認識できないことがあるため、括弧書きの部分は取り除く
// bookingCityが指定されている場合は、地図表示用のcityではなくこちらを検索に使う
// （小規模な町村名がBooking.comの地名データベースで正しく認識されない場合の回避策）
// Booking.com / 楽天トラベルの検索クエリ生成ロジック（括弧書きの除去、「Prefecture」の除去、bookingCity/bookingPrefectureによる上書き）は
// src/lib/accommodation.ts に集約している（神社カード・旅行先ページと共通）。経緯はそちらのコメントを参照。
const accommodationInput = { city, prefecture, bookingCity, bookingPrefecture };
const bookingUrl = buildAccommodationBookingUrl(lang, accommodationInput);
// 楽天トラベルのキーワード検索は日本語専用で、日本語以外のクエリでは
// 地名が一致せず常に検索結果0件になるため、日本語版以外では表示しない
const rakutenUrl = buildAccommodationRakutenUrl(shrineName, accommodationInput);
const t = {
  ja: {
    heading: '周辺の宿泊施設',
    body: '参拝とあわせて宿泊を計画したい方向けに、周辺のホテル・宿を検索できます。海外からの参拝者の方も、そのまま多言語で予約いただけます。',
    bookingSub: `${prefecture}${city}周辺の宿を検索（海外からの予約向け）`,
    rakutenLabel: '楽天トラベル',
    rakutenSub: `${prefecture}${city}周辺の宿を検索`,
    note: '※ 外部の予約サイトに移動します。',
  },
  en: {
    heading: 'Nearby Accommodation',
    body: 'Search hotels and inns near the shrine to plan your stay. Bookings are available in multiple languages for visitors from abroad.',
    bookingSub: `Search stays near ${city}, ${prefecture}`,
    rakutenLabel: 'Rakuten Travel',
    rakutenSub: `Search stays near ${city}, ${prefecture} (Japanese site)`,
    note: '※ Opens an external booking site.',
  },
  zh: {
    heading: '周邊住宿',
    body: '想安排參拜行程順道住宿的話，可以搜尋神社周邊的飯店與旅館。海外旅客也能直接以多國語言完成預訂。',
    bookingSub: `搜尋${city}、${prefecture}周邊的住宿`,
    rakutenLabel: '樂天旅遊',
    rakutenSub: `搜尋${city}、${prefecture}周邊的住宿（日文網站）`,
    note: '※ 將前往外部訂房網站。',
  },
  es: {
    heading: 'Alojamiento Cercano',
    body: 'Busca hoteles y posadas cerca del santuario para planear tu estancia. Las reservas están disponibles en varios idiomas para visitantes del extranjero.',
    bookingSub: `Buscar alojamiento cerca de ${city}, ${prefecture}`,
    rakutenLabel: 'Rakuten Travel',
    rakutenSub: `Buscar alojamiento cerca de ${city}, ${prefecture} (sitio en japonés)`,
    note: '※ Se abrirá un sitio de reservas externo.',
  },
  fr: {
    heading: 'Hébergements à Proximité',
    body: 'Recherchez des hôtels et auberges près du sanctuaire pour organiser votre séjour. Les réservations sont disponibles en plusieurs langues pour les visiteurs venant de l’étranger.',
    bookingSub: `Rechercher un hébergement près de ${city}, ${prefecture}`,
    rakutenLabel: 'Rakuten Travel',
    rakutenSub: `Rechercher un hébergement près de ${city}, ${prefecture} (site en japonais)`,
    note: '※ Redirige vers un site de réservation externe.',
  },
  ko: {
    heading: '주변 숙박 시설',
    body: '참배와 함께 숙박을 계획하시는 분들을 위해, 주변 호텔과 료칸을 검색할 수 있습니다. 해외에서 오신 분들도 여러 언어로 그대로 예약하실 수 있습니다.',
    bookingSub: `${prefecture} ${city} 주변 숙소 검색 (해외 예약 가능)`,
    rakutenLabel: 'Rakuten Travel',
    rakutenSub: `${prefecture} ${city} 주변 숙소 검색 (일본어 사이트)`,
    note: '※ 외부 예약 사이트로 이동합니다.',
  },
}[lang];
---

<div id="accommodation" class="scroll-mt-24 rounded-2xl border border-shrine-gold/30 bg-white p-6 shadow-sm">
  <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">{t.heading}</h2>
  <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
    {t.body}
  </p>

  <div class="mt-4 space-y-2.5">
    <a
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="flex items-center justify-between gap-3 rounded-2xl border border-shrine-gold/30 bg-shrine-paper-dark px-4 py-3 text-sm text-shrine-ink transition hover:border-shrine-vermillion hover:text-shrine-vermillion"
    >
      <span>
        <span class="font-bold">Booking.com</span>
        <span class="block text-xs text-shrine-ink-soft">{t.bookingSub}</span>
      </span>
      <span aria-hidden="true">↗</span>
    </a>

    {lang === 'ja' && (
      <a
        href={rakutenUrl}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="flex items-center justify-between gap-3 rounded-2xl border border-shrine-gold/30 bg-shrine-paper-dark px-4 py-3 text-sm text-shrine-ink transition hover:border-shrine-vermillion hover:text-shrine-vermillion"
      >
        <span>
          <span class="font-bold">{t.rakutenLabel}</span>
          <span class="block text-xs text-shrine-ink-soft">{t.rakutenSub}</span>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>

  <p class="mt-3 text-[11px] leading-relaxed text-shrine-ink-soft/80">
    {t.note}
  </p>
</div>
