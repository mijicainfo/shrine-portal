---
interface Props {
  query: string;
  class?: string;
}

const { query, class: className = '' } = Astro.props;
const embedSrc = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
const linkHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const lang = Astro.currentLocale === 'en' ? 'en' : Astro.currentLocale === 'zh' ? 'zh' : 'ja';
const t = lang === 'en'
  ? { title: `Map of ${query}`, link: 'Open larger map on Google Maps ↗' }
  : lang === 'zh'
  ? { title: `${query}的地圖`, link: '在Google地圖查看更大範圍 ↗' }
  : { title: `${query}の地図`, link: 'Googleマップで大きな地図を見る ↗' };
---

<div class={`overflow-hidden rounded-2xl border border-shrine-gold/30 bg-white shadow-sm ${className}`}>
  <iframe
    src={embedSrc}
    width="100%"
    height="220"
    style="border:0; display:block;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={t.title}
  ></iframe>
  <a
    href={linkHref}
    target="_blank"
    rel="noopener noreferrer"
    class="block px-4 py-2.5 text-center text-xs text-shrine-vermillion transition hover:bg-shrine-vermillion-light hover:text-shrine-vermillion-dark"
  >
    {t.link}
  </a>
</div>
