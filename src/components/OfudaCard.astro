---
// A small illustrative "o-fuda" (paper/wood shrine talisman) shape: a pale
// card with a colored stamp near the top, faint vertical text columns, and a
// small vermillion seal near the bottom — reads as "a shrine talisman" at a
// glance, unlike a torii glyph in a solid color block (which reads as a
// generic app icon instead of paper).
interface Props {
  accent: string;
  class?: string;
}
const { accent, class: className = '' } = Astro.props;
---

<svg viewBox="0 0 60 90" class={className} xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
  <rect x="4" y="4" width="52" height="82" rx="4" fill="#fdf8f1" stroke={accent} stroke-width="2.5" />
  <rect x="21" y="11" width="18" height="11" rx="1.5" fill={accent} />
  <line x1="30" y1="28" x2="30" y2="72" stroke="#5c4f45" stroke-width="2.5" stroke-linecap="round" opacity="0.55" />
  <line x1="22" y1="32" x2="22" y2="60" stroke="#5c4f45" stroke-width="2" stroke-linecap="round" opacity="0.3" />
  <line x1="38" y1="32" x2="38" y2="60" stroke="#5c4f45" stroke-width="2" stroke-linecap="round" opacity="0.3" />
  <circle cx="30" cy="77" r="5.5" fill="#e8887a" opacity="0.9" />
</svg>
