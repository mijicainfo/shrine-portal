---
interface Props {
  handle: string;
  shrineName: string;
}

const { handle, shrineName } = Astro.props;
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: { heading: '最新情報（公式X）', loading: `${shrineName}の投稿を読み込み中…` },
  en: { heading: 'Latest Updates (Official X)', loading: `Loading posts from ${shrineName}…` },
  zh: { heading: '最新消息（官方X）', loading: `正在載入${shrineName}的貼文…` },
  es: { heading: 'Últimas Novedades (X Oficial)', loading: `Cargando publicaciones de ${shrineName}…` },
  fr: { heading: 'Dernières Actualités (X Officiel)', loading: `Chargement des publications de ${shrineName}…` },
  ko: { heading: '최신 소식 (공식 X)', loading: `${shrineName}의 게시물을 불러오는 중…` },
}[lang];
---

<div class="rounded-2xl border border-shrine-gold/30 bg-white p-6 shadow-sm">
  <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">{t.heading}</h2>
  <p class="mt-1 text-xs text-shrine-ink-soft">
    {{
      ja: <>{shrineName}の公式Xアカウント（<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>）の投稿です。</>,
      en: <>Posts from {shrineName}'s official X account (<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>).</>,
      zh: <>來自{shrineName}官方X帳號（<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>）的貼文。</>,
      es: <>Publicaciones de la cuenta oficial de X de {shrineName} (<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>).</>,
      fr: <>Publications du compte X officiel de {shrineName} (<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>).</>,
      ko: <>{shrineName}의 공식 X 계정(<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>)의 게시물입니다.</>,
    }[lang]}
  </p>
  <div class="mt-4 max-h-[500px] overflow-y-auto">
    <a
      class="twitter-timeline"
      data-height="480"
      data-theme="light"
      data-chrome="noheader nofooter noborders transparent"
      href={`https://twitter.com/${handle}?ref_src=twsrc%5Etfw`}
    >
      {t.loading}
    </a>
  </div>
</div>

<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
