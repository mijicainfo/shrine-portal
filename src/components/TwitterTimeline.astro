---
interface Props {
  handle: string;
  shrineName: string;
}

const { handle, shrineName } = Astro.props;
---

<div class="rounded-2xl border border-shrine-gold/30 bg-white p-6 shadow-sm">
  <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">最新情報（公式X）</h2>
  <p class="mt-1 text-xs text-shrine-ink-soft">
    {shrineName}の公式Xアカウント（<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>）の投稿です。
  </p>
  <div class="mt-4 max-h-[500px] overflow-y-auto">
    <a
      class="twitter-timeline"
      data-height="480"
      data-theme="light"
      data-chrome="noheader nofooter noborders transparent"
      href={`https://twitter.com/${handle}?ref_src=twsrc%5Etfw`}
    >
      {shrineName}の投稿を読み込み中…
    </a>
  </div>
</div>

<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
