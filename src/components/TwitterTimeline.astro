---
interface Props {
  handle: string;
  shrineName: string;
}

const { handle, shrineName } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : Astro.currentLocale === 'zh' ? 'zh' : 'ja';
const t = lang === 'en'
  ? { heading: 'Latest Updates (Official X)', loading: `Loading posts from ${shrineName}…` }
  : lang === 'zh'
  ? { heading: '最新消息（官方X）', loading: `正在載入${shrineName}的貼文…` }
  : { heading: '最新情報（公式X）', loading: `${shrineName}の投稿を読み込み中…` };
---

<div class="rounded-2xl border border-shrine-gold/30 bg-white p-6 shadow-sm">
  <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">{t.heading}</h2>
  <p class="mt-1 text-xs text-shrine-ink-soft">
    {lang === 'en' ? (
      <>Posts from {shrineName}'s official X account (<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>).</>
    ) : lang === 'zh' ? (
      <>來自{shrineName}官方X帳號（<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>）的貼文。</>
    ) : (
      <>{shrineName}の公式Xアカウント（<a href={`https://x.com/${handle}`} target="_blank" rel="noopener noreferrer" class="text-shrine-vermillion underline">@{handle}</a>）の投稿です。</>
    )}
  </p>
  <div class="mt-4 max-h-[500px] overflow-y-auto">
    <a
      class="twitter-timeline"
      data-height="480"
      data-theme="light"
      data-chrome="noheader nofooter noborders transparent"
      href={`https://twitter.com/${handle}?ref_src=twsrc%5Etfw`}
    >
      {t.loading}
    </a>
  </div>
</div>

<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
