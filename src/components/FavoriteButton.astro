---
interface Props {
  shrineId: string;
  label?: boolean;
  class?: string;
}

const { shrineId, label = false, class: className = '' } = Astro.props;
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: { active: 'お気に入り済み', inactive: 'お気に入りに追加' },
  en: { active: 'Saved to Favorites', inactive: 'Add to Favorites' },
  zh: { active: '已加入收藏', inactive: '加入收藏' },
  es: { active: 'Guardado en Favoritos', inactive: 'Añadir a Favoritos' },
  fr: { active: 'Ajouté aux Favoris', inactive: 'Ajouter aux Favoris' },
  ko: { active: '즐겨찾기에 저장됨', inactive: '즐겨찾기에 추가' },
}[lang];
---

<button
  type="button"
  data-favorite-btn
  data-shrine-id={shrineId}
  data-label-active={t.active}
  data-label-inactive={t.inactive}
  aria-pressed="false"
  aria-label={t.inactive}
  class={`favorite-btn group flex items-center justify-center gap-2 rounded-full transition ${
    label
      ? 'w-full border border-shrine-gold/40 px-6 py-3 text-sm text-shrine-ink hover:border-shrine-vermillion hover:text-shrine-vermillion'
      : 'h-10 w-10 bg-white/90 text-shrine-vermillion shadow hover:bg-white'
  } ${className}`}
>
  <svg class="h-5 w-5 shrink-0 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M12 21s-7.5-4.6-10-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 10 6c-2.5 4.4-10 9-10 9z"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {label && <span data-label>{t.inactive}</span>}
</button>

<style>
  .favorite-btn.is-active svg {
    fill: currentColor;
  }
</style>
