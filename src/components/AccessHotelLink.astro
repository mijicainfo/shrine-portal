---
// 神社ページの「アクセス」の説明の直後に置く、周辺の宿を探すリンク。
// 検索は市区町村単位（駅名では検索しない）なので、「最寄り駅」ではなく「この周辺」と表示する。
// 日本語は楽天トラベル、他言語はBooking.com（上部の旅の準備バーと同じ検索）。
import { buildAccommodationBookingUrl, buildAccommodationRakutenUrl } from '../lib/accommodation';

interface Props {
  shrineName: string;
  city: string;
  prefecture: string;
  bookingCity?: string;
  bookingPrefecture?: string;
}

type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const { shrineName, city, prefecture, bookingCity, bookingPrefecture } = Astro.props;

const cleanCity = city.replace(/[（(].*?[）)]/g, '').trim() || city;
const input = { city, prefecture, bookingCity, bookingPrefecture };
const href = lang === 'ja' ? buildAccommodationRakutenUrl(shrineName, input) : buildAccommodationBookingUrl(lang, input);

const text: Record<Lang, { label: string; sub: string }> = {
  ja: { label: 'この周辺の宿を探す', sub: `${cleanCity}周辺・楽天トラベル` },
  en: { label: 'Find a hotel near here', sub: `Near ${cleanCity} · Booking.com` },
  zh: { label: '查找這附近的住宿', sub: `${cleanCity}周邊・Booking.com` },
  es: { label: 'Buscar hotel cerca de aquí', sub: `Cerca de ${cleanCity} · Booking.com` },
  fr: { label: 'Trouver un hôtel à proximité', sub: `Près de ${cleanCity} · Booking.com` },
  ko: { label: '이 근처 숙소 찾기', sub: `${cleanCity} 주변 · Booking.com` },
};
const t = text[lang];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer sponsored"
  class="mt-2 flex items-center gap-2 rounded-xl border border-shrine-vermillion/40 bg-shrine-vermillion-light/60 px-3 py-2 text-sm font-bold text-shrine-vermillion-dark no-underline transition hover:bg-shrine-vermillion-light hover:shadow-sm"
>
  <span class="text-lg" aria-hidden="true">🏨</span>
  <span class="min-w-0 leading-tight">
    <span class="block">{t.label}</span>
    <span class="block text-[10px] font-normal text-shrine-ink-soft"><span class="mr-1 rounded bg-shrine-ink-soft/15 px-1 py-px font-bold">PR</span>{t.sub}</span>
  </span>
  <span class="ml-auto shrink-0" aria-hidden="true">↗</span>
</a>
