---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const links = [
  { name: 'X', href: 'https://x.com/shrine2026', icon: 'x' },
] as const;
---

<div class={`flex items-center gap-4 ${className}`}>
  {links.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.name}
      class="text-shrine-paper/70 transition hover:text-shrine-gold"
    >
      {link.icon === 'x' && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M18.3 3H21l-6.4 7.3L22 21h-6.1l-4.8-6.3L5.6 21H3l6.9-7.9L2 3h6.3l4.3 5.8L18.3 3zm-1 16h1.7L7.8 4.9H6l11.3 14.1z" />
        </svg>
      )}
      {link.icon === 'instagram' && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      )}
      {link.icon === 'facebook' && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.3-1.5 1.6-1.5H17V3.6C16.7 3.5 15.7 3.4 14.6 3.4c-2.3 0-3.9 1.4-3.9 4v2.5H8v3.1h2.7V21h2.8z" />
        </svg>
      )}
    </a>
  ))}
</div>
