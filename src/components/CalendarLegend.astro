---
// 凡例：暦注の色と意味、公的発表の印。
import { calendarText } from '../data/calendarText';
import { koyomiStyle } from '../lib/calendarStyle';
import { KOYOMI_ORDER } from '../lib/calendar';

interface Props {
  lang: 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
}
const { lang } = Astro.props;
const t = calendarText[lang];
---

<section class="rounded-2xl border border-shrine-gold/25 bg-white p-5 shadow-sm" aria-labelledby="calendar-legend">
  <h2 id="calendar-legend" class="font-serif-jp text-base font-bold text-shrine-ink">{t.ui.legendHeading}</h2>
  <p class="mt-3 text-xs font-bold text-shrine-ink-soft">{t.ui.legendKoyomi}</p>
  <ul class="mt-2 grid gap-2.5 sm:grid-cols-2">
    {KOYOMI_ORDER.map((k) => (
      <li class="flex gap-2.5 text-sm text-shrine-ink">
        <span class={`mt-1.5 inline-block h-3 w-3 shrink-0 rounded-full ${koyomiStyle[k].dot}`}></span>
        <span>
          <span class="font-bold">{t.koyomi[k].name}</span>
          <span class="block text-xs leading-relaxed text-shrine-ink-soft">{t.koyomi[k].desc}</span>
        </span>
      </li>
    ))}
  </ul>
  <p class="mt-4 text-xs font-bold text-shrine-ink-soft">{t.ui.legendOfficial}</p>
  <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-shrine-ink">
    <li><span class="font-bold text-red-500">12</span> {t.ui.legendHoliday}</li>
    <li><span aria-hidden="true">🌑</span> {t.moon.new}</li>
    <li><span aria-hidden="true">🌕</span> {t.moon.full}</li>
  </ul>
</section>
