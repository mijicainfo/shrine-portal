---
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = Astro.currentLocale === 'en' ? 'en' : 'ja';
const base = lang === 'en' ? '/en' : '';
const t = lang === 'en'
  ? {
      brand: 'Shrine The Pantheon',
      top: 'Home',
      shrines: 'Find Shrines',
      guide: 'Visiting Guide',
      items: 'Amulets & Charms',
      glossary: 'Glossary',
      mypage: 'My Page',
    }
  : {
      brand: '神社 The Pantheon',
      top: 'トップ',
      shrines: '神社を探す',
      guide: '参拝ガイド',
      items: '授与品ガイド',
      glossary: '用語集',
      mypage: 'マイページ',
    };
---

<header class="border-b border-shrine-gold/30 bg-shrine-paper/95 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href={`${base}/`} class="flex items-center gap-2 font-serif-jp text-xl font-bold text-shrine-ink sm:text-2xl">
      <span class="text-2xl text-shrine-vermillion sm:text-3xl">⛩</span>
      <span>{t.brand}</span>
    </a>
    <nav class="hidden items-center gap-5 font-sans-jp text-sm text-shrine-ink-soft sm:flex">
      <a href={`${base}/`} class="transition hover:text-shrine-vermillion">{t.top}</a>
      <a href={`${base}/shrines/`} class="transition hover:text-shrine-vermillion">{t.shrines}</a>
      <a href={`${base}/#guide`} class="transition hover:text-shrine-vermillion">{t.guide}</a>
      <a href={`${base}/items/`} class="transition hover:text-shrine-vermillion">{t.items}</a>
      <a href={`${base}/glossary/`} class="transition hover:text-shrine-vermillion">{t.glossary}</a>
      <a href={`${base}/mypage/`} class="transition hover:text-shrine-vermillion">{t.mypage}</a>
      <LanguageSwitcher />
    </nav>
  </div>
</header>
