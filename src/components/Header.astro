---
import LanguageSwitcher from './LanguageSwitcher.astro';
import BrandMark from './BrandMark.astro';

const lang = Astro.currentLocale === 'en' ? 'en' : Astro.currentLocale === 'zh' ? 'zh' : 'ja';
const base = lang === 'en' ? '/en' : lang === 'zh' ? '/zh' : '';
const t = lang === 'en'
  ? {
      brand: 'Shrine The Pantheon',
      top: 'Home',
      shrines: 'Find Shrines',
      guide: 'Visiting Guide',
      items: 'Amulets & Charms',
      glossary: 'Glossary',
      mypage: 'My Page',
      openMenu: 'Open menu',
      closeMenu: 'Close menu',
    }
  : lang === 'zh'
  ? {
      brand: '神社 The Pantheon',
      top: '首頁',
      shrines: '尋找神社',
      guide: '參拜指南',
      items: '御守與授與品',
      glossary: '用語集',
      mypage: '我的頁面',
      openMenu: '開啟選單',
      closeMenu: '關閉選單',
    }
  : {
      brand: '神社 The Pantheon',
      top: 'トップ',
      shrines: '神社を探す',
      guide: '参拝ガイド',
      items: '授与品ガイド',
      glossary: '用語集',
      mypage: 'マイページ',
      openMenu: 'メニューを開く',
      closeMenu: 'メニューを閉じる',
    };

const navLinks = [
  { href: `${base}/`, label: t.top },
  { href: `${base}/shrines/`, label: t.shrines },
  { href: `${base}/#guide`, label: t.guide },
  { href: `${base}/items/`, label: t.items },
  { href: `${base}/glossary/`, label: t.glossary },
  { href: `${base}/mypage/`, label: t.mypage },
];
---

<header class="border-b border-shrine-gold/30 bg-shrine-paper/95 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href={`${base}/`} class="flex items-center gap-2 font-serif-jp text-xl font-bold text-shrine-ink sm:text-2xl">
      <BrandMark class="h-8 w-8 shrink-0 sm:h-9 sm:w-9" />
      <span>{t.brand}</span>
    </a>
    <nav class="hidden items-center gap-5 font-sans-jp text-sm text-shrine-ink-soft sm:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="transition hover:text-shrine-vermillion">{link.label}</a>
      ))}
      <LanguageSwitcher />
    </nav>
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-full text-shrine-ink transition hover:bg-shrine-vermillion-light sm:hidden"
      aria-label={t.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="mobile-menu-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <svg id="mobile-menu-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-shrine-gold/20 bg-shrine-paper px-4 py-3 font-sans-jp text-sm text-shrine-ink sm:hidden"
  >
    {navLinks.map((link) => (
      <a href={link.href} class="rounded-lg px-2 py-2.5 transition hover:bg-shrine-vermillion-light hover:text-shrine-vermillion-dark">{link.label}</a>
    ))}
    <div class="mt-1 px-2 py-1.5">
      <LanguageSwitcher />
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
