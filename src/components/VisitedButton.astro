---
interface Props {
  shrineId: string;
  class?: string;
}

const { shrineId, class: className = '' } = Astro.props;
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: { active: '参拝済み', inactive: '参拝済みにする' },
  en: { active: 'Visited', inactive: 'Mark as Visited' },
  zh: { active: '已參拜', inactive: '標記為已參拜' },
  es: { active: 'Visitado', inactive: 'Marcar como Visitado' },
  fr: { active: 'Visité', inactive: 'Marquer comme Visité' },
  ko: { active: '참배 완료', inactive: '참배 완료로 표시' },
}[lang];
---

<button
  type="button"
  data-visited-btn
  data-shrine-id={shrineId}
  data-label-active={t.active}
  data-label-inactive={t.inactive}
  aria-pressed="false"
  class={`visited-btn flex w-full items-center justify-center gap-2 rounded-full border border-shrine-gold/40 px-6 py-3 text-sm text-shrine-ink transition hover:border-shrine-vermillion hover:text-shrine-vermillion ${className}`}
>
  <svg class="h-4 w-4 shrink-0 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span data-label>{t.inactive}</span>
</button>

<style>
  .visited-btn.is-active {
    background-color: var(--color-shrine-vermillion);
    border-color: var(--color-shrine-vermillion);
    color: white;
  }
</style>
