---
// 「この日に合う神社」の小さな一覧。画像は小さなサムネイルのみ（月ページは日数が多いので軽くする）。
import { Image } from 'astro:assets';
import { benefitTranslations } from '../data/benefitTranslations';
import { benefitTranslationsZh } from '../data/benefitTranslationsZh';
import { benefitTranslationsEs } from '../data/benefitTranslationsEs';
import { benefitTranslationsFr } from '../data/benefitTranslationsFr';
import { benefitTranslationsKo } from '../data/benefitTranslationsKo';

interface Props {
  shrines: any[];
  lang: 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
}
const { shrines, lang } = Astro.props;
const base = lang === 'ja' ? '' : `/${lang}`;
const maps: Partial<Record<typeof lang, Record<string, string>>> = {
  en: benefitTranslations,
  zh: benefitTranslationsZh,
  es: benefitTranslationsEs,
  fr: benefitTranslationsFr,
  ko: benefitTranslationsKo,
};
const tr = (tag: string) => maps[lang]?.[tag] ?? tag;
const sep: Record<typeof lang, string> = { ja: '・', en: ', ', zh: '、', es: ', ', fr: ', ', ko: '・' };
---

<ul class="grid gap-2 sm:grid-cols-3">
  {shrines.map((s) => (
    <li>
      <a
        href={`${base}/shrines/${s.id}/`}
        class="flex h-full items-center gap-2.5 rounded-xl border border-shrine-gold/25 bg-white p-2 transition hover:border-shrine-vermillion hover:shadow-sm"
      >
        {s.data.image ? (
          <Image src={s.data.image} alt="" width={96} height={64} loading="lazy" class="h-14 w-20 shrink-0 rounded-lg object-cover" />
        ) : (
          <span class="h-14 w-20 shrink-0 rounded-lg bg-shrine-paper-dark" aria-hidden="true"></span>
        )}
        <span class="min-w-0">
          <span class="block truncate text-sm font-bold text-shrine-ink">{s.data.name}</span>
          <span class="block truncate text-[11px] text-shrine-ink-soft">{s.data.prefecture}{sep[lang]}{s.data.city}</span>
          <span class="block truncate text-[11px] text-shrine-vermillion-dark">{(s.data.benefits ?? []).slice(0, 2).map(tr).join(sep[lang])}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
