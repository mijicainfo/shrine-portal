---
import { buildKlookSearchUrl } from '../data/affiliate';

interface Props {
  city: string;
  prefecture: string;
}

const { city, prefecture } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : Astro.currentLocale === 'zh' ? 'zh' : 'ja';
const cleanCity = city.replace(/[（(].*?[）)]/g, '').trim();
const bookingPrefecture = prefecture.replace(/\s*Prefecture$/i, '');
const klookQuery = lang === 'en' || lang === 'zh' ? `${cleanCity}, ${bookingPrefecture}` : `${prefecture}${cleanCity}`;
const klookUrl = buildKlookSearchUrl(klookQuery, lang);
const t = {
  ja: {
    heading: '周辺の観光・体験',
    body: '参拝とあわせて楽しめる、周辺の観光チケットやアクティビティを探せます。',
    klookSub: `${prefecture}${city}周辺のツアー・体験・入場チケットを検索`,
    note: '※ 外部の予約サイトに移動します。',
  },
  en: {
    heading: 'Nearby Tours & Activities',
    body: 'Find tours, activities, and attraction tickets near the shrine to round out your visit.',
    klookSub: `Search tours & tickets near ${city}, ${prefecture}`,
    note: '※ Opens an external booking site.',
  },
  zh: {
    heading: '周邊觀光體驗',
    body: '搭配參拜行程，探索神社周邊的觀光票券與各式體驗活動。',
    klookSub: `搜尋${city}、${prefecture}周邊的行程、體驗與門票`,
    note: '※ 將前往外部訂購網站。',
  },
}[lang];
---

<div class="rounded-2xl border border-shrine-gold/30 bg-white p-6 shadow-sm">
  <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">{t.heading}</h2>
  <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
    {t.body}
  </p>

  <div class="mt-4 space-y-2.5">
    <a
      href={klookUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="flex items-center justify-between gap-3 rounded-2xl border border-shrine-gold/30 bg-shrine-paper-dark px-4 py-3 text-sm text-shrine-ink transition hover:border-shrine-vermillion hover:text-shrine-vermillion"
    >
      <span>
        <span class="font-bold">Klook</span>
        <span class="block text-xs text-shrine-ink-soft">{t.klookSub}</span>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <p class="mt-3 text-[11px] leading-relaxed text-shrine-ink-soft/80">
    {t.note}
  </p>
</div>
