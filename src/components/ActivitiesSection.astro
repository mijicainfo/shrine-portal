---
import { buildKlookSearchUrl } from '../data/affiliate';
import { buildKlookArea } from '../lib/klook';
import { buildTripcomActivitiesUrl, type TripHotelTarget } from '../data/tripcom';

interface Props {
  city: string;
  prefecture: string;
  trip?: TripHotelTarget;
}

const { city, prefecture, trip } = Astro.props;
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const cleanCity = city.replace(/[（(].*?[）)]/g, '').trim();
const klook = buildKlookArea(lang, prefecture, cleanCity);
// 日本語以外は Trip.com の「遊び・体験」（市の一覧）。市の一覧がない市と日本語ページは Klook。
const tripUrl = trip ? buildTripcomActivitiesUrl(lang, trip) : undefined;
const klookUrl = tripUrl ?? buildKlookSearchUrl(klook.query, lang);
const partnerName = tripUrl ? 'Trip.com' : 'Klook';
const t = {
  ja: {
    heading: '周辺の観光・体験',
    body: '参拝とあわせて楽しめる、周辺の観光チケットやアクティビティを探せます。',
    klookSub: tripUrl ? `${prefecture}${city}周辺のツアー・体験・入場チケットを検索` : `「${klook.area}」のツアー・体験を検索`,
    note: '※ 外部の予約サイトに移動します。',
  },
  en: {
    heading: 'Nearby Tours & Activities',
    body: 'Find tours, activities, and attraction tickets near the shrine to round out your visit.',
    klookSub: tripUrl ? `Search tours & tickets near ${city}, ${prefecture}` : `Search tours in ${klook.area}`,
    note: '※ Opens an external booking site.',
  },
  zh: {
    heading: '周邊觀光體驗',
    body: '搭配參拜行程，探索神社周邊的觀光票券與各式體驗活動。',
    klookSub: tripUrl ? `搜尋${city}、${prefecture}周邊的行程、體驗與門票` : `搜尋「${klook.area}」的行程與體驗`,
    note: '※ 將前往外部訂購網站。',
  },
  es: {
    heading: 'Tours y Actividades Cercanas',
    body: 'Encuentra tours, actividades y entradas a atracciones cerca del santuario para completar tu visita.',
    klookSub: tripUrl ? `Buscar tours y entradas cerca de ${city}, ${prefecture}` : `Buscar tours en ${klook.area}`,
    note: '※ Se abrirá un sitio de reservas externo.',
  },
  fr: {
    heading: 'Visites et Activités à Proximité',
    body: 'Trouvez des visites, activités et billets d’attractions près du sanctuaire pour compléter votre visite.',
    klookSub: tripUrl ? `Rechercher des visites et billets près de ${city}, ${prefecture}` : `Rechercher des visites : ${klook.area}`,
    note: '※ Redirige vers un site de réservation externe.',
  },
  ko: {
    heading: '주변 투어 & 액티비티',
    body: '참배와 함께 즐길 수 있는 주변 관광 티켓과 액티비티를 찾아보세요.',
    klookSub: tripUrl ? `${prefecture} ${city} 주변 투어・체험・입장권 검색` : `${klook.area} 투어・체험 검색`,
    note: '※ 외부 예약 사이트로 이동합니다.',
  },
}[lang];
---

<div class="rounded-2xl border border-shrine-gold/30 bg-white p-6 shadow-sm">
  <h2 class="font-serif-jp text-lg font-bold text-shrine-ink">{t.heading}</h2>
  <p class="mt-2 text-sm leading-relaxed text-shrine-ink-soft">
    {t.body}
  </p>

  <div class="mt-4 space-y-2.5">
    <a
      href={klookUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="flex items-center justify-between gap-3 rounded-2xl border border-shrine-gold/30 bg-shrine-paper-dark px-4 py-3 text-sm text-shrine-ink transition hover:border-shrine-vermillion hover:text-shrine-vermillion"
    >
      <span>
        <span class="font-bold">{partnerName}</span>
        <span class="block text-xs text-shrine-ink-soft">{t.klookSub}</span>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <p class="mt-3 text-[11px] leading-relaxed text-shrine-ink-soft/80">
    {t.note}
  </p>
</div>
