---
// A side-elevation "room" scene: kamidana mounted high on the wall (left),
// a person standing at a natural distance (right), two horizontal reference
// lines (shelf height / eye level) spanning between them, and two vertical
// arrows bridging the gap — this reads as an actual height comparison much
// more directly than stacking the same two icons in one narrow column.
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: {
    kamidana: '神棚',
    eyeline: '目線',
    callout: '神棚は目線より高い位置にお祀りします',
    footer: '南向き、または東向きになる場所が理想的とされています',
  },
  en: {
    kamidana: 'Kamidana',
    eyeline: 'Eye level',
    callout: 'Enshrine the kamidana above eye level.',
    footer: 'Facing south or east is considered ideal.',
  },
  zh: {
    kamidana: '神棚',
    eyeline: '視線高度',
    callout: '神棚應供奉於高於視線的位置。',
    footer: '一般認為朝南或朝東的位置最為理想。',
  },
  es: {
    kamidana: 'Kamidana',
    eyeline: 'Altura de los ojos',
    callout: 'El kamidana se instala por encima de la altura de los ojos.',
    footer: 'Se considera ideal que esté orientado hacia el sur o el este.',
  },
  fr: {
    kamidana: 'Kamidana',
    eyeline: 'Hauteur des yeux',
    callout: 'Le kamidana s’installe au-dessus de la hauteur des yeux.',
    footer: 'Une orientation vers le sud ou l’est est considérée comme idéale.',
  },
  ko: {
    kamidana: '가미다나',
    eyeline: '눈높이',
    callout: '가미다나는 눈높이보다 높은 위치에 모십니다.',
    footer: '남향 또는 동향이 이상적이라고 여겨집니다.',
  },
}[lang];
---

<div class="mx-auto max-w-md rounded-2xl border border-shrine-gold/25 bg-shrine-paper-dark p-6">
  <svg viewBox="0 0 400 200" class="w-full" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.callout}>
    <!-- shelf-height reference line -->
    <line x1="10" y1="55" x2="390" y2="55" stroke="#d16a5c" stroke-width="2" stroke-dasharray="5 4" opacity="0.55" />
    <!-- eye-level reference line -->
    <line x1="10" y1="130" x2="390" y2="130" stroke="#d16a5c" stroke-width="2" stroke-dasharray="5 4" opacity="0.55" />

    <!-- kamidana, mounted on a wall shelf -->
    <path d="M 20 37 L 100 37 L 88 25 L 32 25 Z" fill="#ddb877" />
    <rect x="38" y="37" width="44" height="18" rx="2" fill="#d16a5c" />
    <rect x="25" y="55" width="70" height="4" rx="1.5" fill="#93867a" opacity="0.5" />
    <text x="60" y="76" text-anchor="middle" font-size="12" font-weight="bold" fill="#5c4f45">{t.kamidana}</text>

    <!-- arrow 1, right next to the kamidana -->
    <line x1="140" y1="128" x2="140" y2="60" stroke="#d16a5c" stroke-width="3" stroke-linecap="round" />
    <polygon points="132,60 148,60 140,47" fill="#d16a5c" />

    <!-- arrow 2, right next to the person -->
    <line x1="300" y1="128" x2="300" y2="60" stroke="#d16a5c" stroke-width="3" stroke-linecap="round" />
    <polygon points="292,60 308,60 300,47" fill="#d16a5c" />

    <!-- person, standing at eye level with the lower reference line -->
    <circle cx="340" cy="130" r="13" fill="#5c4f45" />
    <path d="M 323 195 L 326 148 Q 327 142 340 142 Q 353 142 354 148 L 357 195 Z" fill="#5c4f45" />
    <rect x="308" y="196" width="64" height="3" rx="1.5" fill="#93867a" opacity="0.5" />
    <text x="388" y="123" text-anchor="end" font-size="11" fill="#d16a5c">{t.eyeline}</text>
  </svg>

  <p class="mt-3 rounded-xl bg-white px-4 py-3 text-center text-sm font-bold leading-snug text-shrine-ink">
    {t.callout}
  </p>
  <p class="mt-2 text-center text-xs text-shrine-ink-soft">{t.footer}</p>
</div>
