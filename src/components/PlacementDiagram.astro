---
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: { kamidana: '神棚', eyeline: '目線', above: '目線より高く', footer: '南向き、または東向きになる場所が理想的とされています' },
  en: { kamidana: 'Kamidana', eyeline: 'Eye level', above: 'Above eye level', footer: 'Facing south or east is considered ideal.' },
  zh: { kamidana: '神棚', eyeline: '視線高度', above: '高於視線', footer: '一般認為朝南或朝東的位置最為理想。' },
  es: { kamidana: 'Kamidana', eyeline: 'Altura de los ojos', above: 'Por encima de la altura de los ojos', footer: 'Se considera ideal que esté orientado hacia el sur o el este.' },
  fr: { kamidana: 'Kamidana', eyeline: 'Hauteur des yeux', above: 'Au-dessus de la hauteur des yeux', footer: 'Une orientation vers le sud ou l’est est considérée comme idéale.' },
  ko: { kamidana: '가미다나', eyeline: '눈높이', above: '눈높이보다 높게', footer: '남향 또는 동향이 이상적이라고 여겨집니다.' },
}[lang];
---

<div class="mx-auto max-w-xs rounded-2xl border border-shrine-gold/25 bg-shrine-paper-dark p-6">
  <div class="relative" style="height: 224px;">
    <!-- kamidana, mounted on a small wall shelf -->
    <div class="absolute left-1/2 -translate-x-1/2 text-center" style="top: 8px;">
      <div class="mx-auto flex h-10 w-14 items-center justify-center rounded bg-gradient-to-br from-shrine-gold to-shrine-vermillion-dark text-xl text-white shadow">⛩</div>
      <div class="mx-auto -mt-0.5 h-1 w-20 rounded-full bg-shrine-ink-soft/40"></div>
      <p class="mt-1 text-[11px] font-bold text-shrine-ink">{t.kamidana}</p>
    </div>

    <!-- connecting bracket: directly links the kamidana's shelf to the eye-level line -->
    <div class="absolute left-1/2 flex -translate-x-1/2 flex-col items-center" style="top: 74px; height: 50px; width: 20px;">
      <span class="text-[10px] leading-none text-shrine-vermillion-dark">▲</span>
      <div class="w-px flex-1 border-l-2 border-dashed border-shrine-vermillion-dark/50"></div>
      <span class="text-[10px] leading-none text-shrine-vermillion-dark">▼</span>
    </div>
    <div
      class="absolute rounded bg-shrine-paper-dark px-1.5 text-center text-[9px] font-bold leading-tight text-shrine-vermillion-dark"
      style="left: 50%; top: 86px; transform: translateX(14px); width: 68px;"
    >
      {t.above}
    </div>

    <!-- eye-level line, spanning the full width -->
    <div class="absolute inset-x-2 border-t-2 border-dashed border-shrine-vermillion/60" style="top: 124px;">
      <span class="absolute -top-2.5 right-0 bg-shrine-paper-dark px-1 text-[10px] text-shrine-vermillion-dark">{t.eyeline}</span>
    </div>

    <!-- person, eyes roughly aligned with the eye-level line above -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 text-5xl" aria-hidden="true">🧍</div>
  </div>

  <p class="mt-2 text-center text-xs text-shrine-ink-soft">{t.footer}</p>
</div>
