---
const lang = Astro.currentLocale === 'en' ? 'en' : Astro.currentLocale === 'zh' ? 'zh' : 'ja';
const t = lang === 'en'
  ? { kamidana: 'Kamidana', eyeline: 'Eye level', above: 'Above eye level', footer: 'Facing south or east is considered ideal.' }
  : lang === 'zh'
  ? { kamidana: '神棚', eyeline: '視線高度', above: '高於視線', footer: '一般認為朝南或朝東的位置最為理想。' }
  : { kamidana: '神棚', eyeline: '目線', above: '目線より高く', footer: '南向き、または東向きになる場所が理想的とされています' };
---

<div class="mx-auto max-w-xs rounded-2xl border border-shrine-gold/25 bg-shrine-paper-dark p-6">
  <div class="relative h-52">
    <div class="absolute left-1/2 top-1 -translate-x-1/2 text-center">
      <div class="mx-auto flex h-12 w-16 items-center justify-center rounded bg-gradient-to-br from-shrine-gold to-shrine-vermillion-dark text-2xl text-white shadow">⛩</div>
      <p class="mt-1 text-[11px] font-bold text-shrine-ink">{t.kamidana}</p>
    </div>

    <div class="absolute inset-x-2 top-28 border-t-2 border-dashed border-shrine-vermillion/60">
      <span class="absolute -top-2.5 right-0 bg-shrine-paper-dark px-1 text-[10px] text-shrine-vermillion-dark">{t.eyeline}</span>
    </div>

    <div class="absolute left-0 top-16 flex h-24 flex-col items-center justify-between text-shrine-vermillion-dark">
      <span class="text-xs">▲</span>
      <span class="text-[9px] leading-tight text-shrine-ink-soft" style="writing-mode: vertical-rl;">{t.above}</span>
      <span class="text-xs">▼</span>
    </div>

    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 text-4xl" aria-hidden="true">🧍</div>
  </div>

  <p class="mt-2 text-center text-xs text-shrine-ink-soft">{t.footer}</p>
</div>
