const t = {
  ja: {
    tagline: '日本全国の神社を、もっと身近に。',
    correction: 'お問い合わせ',
    correctionPrefix: '掲載内容に誤りや訂正すべき点がございましたら、',
    correctionSuffix: 'よりお知らせください。',
    privacy: 'プライバシーポリシー',
    copyright: '© 2026 神社 The Pantheon',
    languages: '言語',
  },
  en: {
    tagline: 'Bringing Japan’s shrines closer to everyone.',
    correction: 'correction',
    correctionPrefix: 'Spot an error or something out of date? Please let us know via our',
    correctionSuffix: 'page.',
    privacy: 'Privacy Policy',
    copyright: '© 2026 Shrine The Pantheon',
    languages: 'Languages',
  },
  zh: {
    tagline: '讓日本全國的神社，離每個人更近一些。',
    correction: '聯絡我們',
    correctionPrefix: '如發現內容有誤或需要更新之處，歡迎透過',
    correctionSuffix: '頁面告訴我們。',
    privacy: '隱私權政策',
    copyright: '© 2026 神社 The Pantheon',
    languages: '語言',
  },
  es: {
    tagline: 'Acercando los santuarios de Japón a todos.',
    correction: 'contacto',
    correctionPrefix: '¿Encontraste un error o algo desactualizado? Avísanos a través de nuestra página de',
    correctionSuffix: '.',
    privacy: 'Política de Privacidad',
    copyright: '© 2026 Shrine The Pantheon',
    languages: 'Idiomas',
  },
  fr: {
    tagline: 'Rapprocher les sanctuaires du Japon de chacun.',
    correction: 'contact',
    correctionPrefix: 'Vous avez repéré une erreur ou une information obsolète ? Merci de nous le signaler via notre page de',
    correctionSuffix: '.',
    privacy: 'Politique de Confidentialité',
    copyright: '© 2026 Shrine The Pantheon',
    languages: 'Langues',
  },
  ko: {
    tagline: '일본 전국의 신사를, 모두에게 더 가깝게.',
    correction: '문의하기',
    correctionPrefix: '내용에 오류가 있거나 수정이 필요한 부분이 있다면,',
    correctionSuffix: '페이지로 알려주세요.',
    privacy: '개인정보처리방침',
    copyright: '© 2026 神社 The Pantheon',
    languages: '언어',
  },
}[lang];

const languageLinks: { href: string; label: string }[] = [
  { href: '/', label: '日本語' },
  { href: '/en/', label: 'English' },
  { href: '/zh/', label: '繁體中文' },
  { href: '/es/', label: 'Español' },
  { href: '/fr/', label: 'Français' },
  { href: '/ko/', label: '한국어' },
];
---

<footer class="mt-24 bg-shrine-indigo-dark py-12 text-shrine-paper">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href={`${base}/`} class="flex items-center gap-2 font-serif-jp text-lg font-bold">
          <BrandMark class="h-7 w-7 shrink-0" />
          {brandName}
        </a>
        <p class="mt-2 text-sm text-shrine-paper/70">{t.tagline}</p>
        <div class="mt-4">
          <SocialLinks />
        </div>
      </div>

      {linkColumns.map((column) => (
        <div>
          <p class="text-xs font-bold tracking-wide text-shrine-gold">{column.title}</p>
          <ul class="mt-3 space-y-2 text-sm text-shrine-paper/80">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-shrine-gold">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-center sm:text-left">
      <p class="text-xs font-bold tracking-wide text-shrine-gold">{t.languages}</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm text-shrine-paper/80 sm:justify-start">
        {languageLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-shrine-gold">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-6 flex flex-col items-center gap-2 border-t border-white/10 pt-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-xs text-shrine-paper/60">
        {t.correctionPrefix}<a href={`${base}/contact/`} class="text-shrine-gold underline hover:text-white">{t.correction}</a>{t.correctionSuffix}
      </p>
      <a href={`${base}/privacy/`} class="text-xs text-shrine-paper/60 underline hover:text-white">{t.privacy}</a>
      <p class="text-xs text-shrine-paper/50">
        {t.copyright}
      </p>
    </div>
  </div>
</footer>
