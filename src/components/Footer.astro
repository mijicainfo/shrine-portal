        { href: `${base}/items/`, label: 'Amulets & Charms Guide' },
        { href: `${base}/kamidana/`, label: 'Home Altar (Kamidana) Guide' },
      ],
    },
  ],
  zh: [
    {
      title: '尋找神社',
      links: [
        { href: `${base}/shrines/`, label: '瀏覽與搜尋神社' },
        { href: `${base}/#prefectures`, label: '依都道府縣搜尋' },
        { href: `${base}/#benefits`, label: '依御利益搜尋' },
        { href: `${base}/mypage/`, label: '我的頁面（收藏與參拜紀錄）' },
      ],
    },
    {
      title: '參拜指南',
      links: [
        { href: `${base}/#guide`, label: '新手參拜指南' },
        { href: `${base}/#shinto`, label: '關於神社與神明' },
        { href: `${base}/deities/`, label: '御祭神導覽' },
        { href: `${base}/glossary/`, label: '用語集' },
      ],
    },
    {
      title: '御守與授與品',
