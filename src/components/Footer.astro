        { href: `${base}/shrines/`, label: '신사 목록・검색' },
        { href: `${base}/#prefectures`, label: '지역(현)별로 찾기' },
        { href: `${base}/#benefits`, label: '가호별로 찾기' },
        { href: `${base}/mypage/`, label: '마이페이지 (즐겨찾기 & 참배 기록)' },
