---
import SocialLinks from './SocialLinks.astro';

const linkColumns = [
  {
    title: '神社を探す',
    links: [
      { href: '/shrines/', label: '神社一覧・検索' },
      { href: '/#prefectures', label: '都道府県から探す' },
      { href: '/#benefits', label: 'ご利益から探す' },
      { href: '/mypage/', label: 'マイページ（お気に入り・参拝記録）' },
    ],
  },
  {
    title: '参拝ガイド',
    links: [
      { href: '/#guide', label: 'はじめての参拝ガイド' },
      { href: '/#shinto', label: '神社と神様について' },
      { href: '/deities/', label: '御祭神ガイド' },
      { href: '/glossary/', label: '用語集' },
    ],
  },
  {
    title: 'お参りの授与品',
    links: [
      { href: '/items/', label: '授与品ガイド' },
      { href: '/kamidana/', label: '神棚の祀り方' },
    ],
  },
];
---

<footer class="mt-24 bg-shrine-indigo-dark py-12 text-shrine-paper">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="font-serif-jp text-lg font-bold">⛩ 全国神社ポータル</a>
        <p class="mt-2 text-sm text-shrine-paper/70">日本全国の神社を、もっと身近に。</p>
        <div class="mt-4">
          <SocialLinks />
        </div>
      </div>

      {linkColumns.map((column) => (
        <div>
          <p class="text-xs font-bold tracking-wide text-shrine-gold">{column.title}</p>
          <ul class="mt-3 space-y-2 text-sm text-shrine-paper/80">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-shrine-gold">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center gap-2 border-t border-white/10 pt-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-xs text-shrine-paper/60">
        掲載内容に誤りや訂正すべき点がございましたら、<a href="/contact/" class="text-shrine-gold underline hover:text-white">お問い合わせ</a>よりお知らせください。
      </p>
      <p class="text-xs text-shrine-paper/50">
        &copy; 2026 全国神社ポータル（開発中サイト）
      </p>
    </div>
  </div>
</footer>
