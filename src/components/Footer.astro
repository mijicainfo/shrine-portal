---
import SocialLinks from './SocialLinks.astro';

const lang = Astro.currentLocale === 'en' ? 'en' : 'ja';
const base = lang === 'en' ? '/en' : '';

const linkColumns = lang === 'en'
  ? [
      {
        title: 'Find Shrines',
        links: [
          { href: `${base}/shrines/`, label: 'Browse & Search Shrines' },
          { href: `${base}/#prefectures`, label: 'Search by Prefecture' },
          { href: `${base}/#benefits`, label: 'Search by Blessing' },
          { href: `${base}/mypage/`, label: 'My Page (Favorites & Visits)' },
        ],
      },
      {
        title: 'Visiting Guide',
        links: [
          { href: `${base}/#guide`, label: 'Beginner’s Visiting Guide' },
          { href: `${base}/#shinto`, label: 'About Shrines & Kami' },
          { href: `${base}/deities/`, label: 'Guide to the Kami' },
          { href: `${base}/glossary/`, label: 'Glossary' },
        ],
      },
      {
        title: 'Amulets & Charms',
        links: [
          { href: `${base}/items/`, label: 'Amulets & Charms Guide' },
          { href: `${base}/kamidana/`, label: 'Home Altar (Kamidana) Guide' },
        ],
      },
    ]
  : [
      {
        title: '神社を探す',
        links: [
          { href: '/shrines/', label: '神社一覧・検索' },
          { href: '/#prefectures', label: '都道府県から探す' },
          { href: '/#benefits', label: 'ご利益から探す' },
          { href: '/mypage/', label: 'マイページ（お気に入り・参拝記録）' },
        ],
      },
      {
        title: '参拝ガイド',
        links: [
          { href: '/#guide', label: 'はじめての参拝ガイド' },
          { href: '/#shinto', label: '神社と神様について' },
          { href: '/deities/', label: '御祭神ガイド' },
          { href: '/glossary/', label: '用語集' },
        ],
      },
      {
        title: 'お参りの授与品',
        links: [
          { href: '/items/', label: '授与品ガイド' },
          { href: '/kamidana/', label: '神棚の祀り方' },
        ],
      },
    ];

const t = lang === 'en'
  ? {
      tagline: 'Bringing Japan’s shrines closer to everyone.',
      correction: 'correction',
      correctionPrefix: 'Spot an error or something out of date? Please let us know via our',
      correctionSuffix: 'page.',
      privacy: 'Privacy Policy',
      copyright: '© 2026 Shrine The Pantheon (site in development)',
    }
  : {
      tagline: '日本全国の神社を、もっと身近に。',
      correction: 'お問い合わせ',
      correctionPrefix: '掲載内容に誤りや訂正すべき点がございましたら、',
      correctionSuffix: 'よりお知らせください。',
      privacy: 'プライバシーポリシー',
      copyright: '© 2026 神社 The Pantheon（開発中サイト）',
    };
---

<footer class="mt-24 bg-shrine-indigo-dark py-12 text-shrine-paper">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href={`${base}/`} class="font-serif-jp text-lg font-bold">⛩ {lang === 'en' ? 'Shrine The Pantheon' : '神社 The Pantheon'}</a>
        <p class="mt-2 text-sm text-shrine-paper/70">{t.tagline}</p>
        <div class="mt-4">
          <SocialLinks />
        </div>
      </div>

      {linkColumns.map((column) => (
        <div>
          <p class="text-xs font-bold tracking-wide text-shrine-gold">{column.title}</p>
          <ul class="mt-3 space-y-2 text-sm text-shrine-paper/80">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-shrine-gold">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center gap-2 border-t border-white/10 pt-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-xs text-shrine-paper/60">
        {t.correctionPrefix}<a href={`${base}/contact/`} class="text-shrine-gold underline hover:text-white">{t.correction}</a>{t.correctionSuffix}
      </p>
      <a href={`${base}/privacy/`} class="text-xs text-shrine-paper/60 underline hover:text-white">{t.privacy}</a>
      <p class="text-xs text-shrine-paper/50">
        {t.copyright}
      </p>
    </div>
  </div>
</footer>
