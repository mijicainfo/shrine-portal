        { href: `${base}/mypage/`, label: 'Ma Page (Favoris et Visites)' },
      ],
    },
    {
      title: 'Guide de Visite',
      links: [
        { href: `${base}/#guide`, label: 'Guide de Visite pour Débutants' },
