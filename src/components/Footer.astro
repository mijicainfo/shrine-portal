        { href: `${base}/shrines/`, label: 'Explorar y Buscar Santuarios' },
        { href: `${base}/#prefectures`, label: 'Buscar por Prefectura' },
        { href: `${base}/#benefits`, label: 'Buscar por Bendición' },
        { href: `${base}/mypage/`, label: 'Mi Página (Favoritos y Visitas)' },
      ],
    },
    {
      title: 'Guía de Visita',
      links: [
        { href: `${base}/#guide`, label: 'Guía de Visita para Principiantes' },
        { href: `${base}/#shinto`, label: 'Sobre los Santuarios y los Kami' },
