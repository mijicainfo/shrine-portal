---
import SocialLinks from './SocialLinks.astro';
import BrandMark from './BrandMark.astro';

type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const base = lang === 'ja' ? '' : `/${lang}`;
const brandName = lang === 'ja' || lang === 'zh' || lang === 'ko' ? '神社 The Pantheon' : 'Shrine The Pantheon';

const linkColumns = {
  ja: [
    {
      title: '神社を探す',
      links: [
        { href: `${base}/shrines/`, label: '神社一覧・検索' },
        { href: `${base}/#prefectures`, label: '都道府県から探す' },
        { href: `${base}/#benefits`, label: 'ご利益から探す' },
        { href: `${base}/mypage/`, label: 'マイページ（お気に入り・参拝記録）' },
      ],
    },
    {
      title: '参拝ガイド',
      links: [
        { href: `${base}/#guide`, label: 'はじめての参拝ガイド' },
        { href: `${base}/#shinto`, label: '神社と神様について' },
        { href: `${base}/deities/`, label: '御祭神ガイド' },
        { href: `${base}/glossary/`, label: '用語集' },
      ],
    },
    {
      title: 'お参りの授与品',
      links: [
        { href: `${base}/items/`, label: '授与品ガイド' },
        { href: `${base}/kamidana/`, label: '神棚の祀り方' },
      ],
    },
  ],
  en: [
    {
      title: 'Find Shrines',
      links: [
        { href: `${base}/shrines/`, label: 'Browse & Search Shrines' },
        { href: `${base}/#prefectures`, label: 'Search by Prefecture' },
        { href: `${base}/#benefits`, label: 'Search by Blessing' },
        { href: `${base}/mypage/`, label: 'My Page (Favorites & Visits)' },
      ],
    },
    {
      title: 'Visiting Guide',
      links: [
        { href: `${base}/#guide`, label: 'Beginner’s Visiting Guide' },
        { href: `${base}/#shinto`, label: 'About Shrines & Kami' },
        { href: `${base}/deities/`, label: 'Guide to the Kami' },
        { href: `${base}/glossary/`, label: 'Glossary' },
      ],
    },
    {
      title: 'Amulets & Charms',
