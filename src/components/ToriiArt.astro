---
interface Props {
  theme?: 'vermillion' | 'indigo' | 'gold';
  class?: string;
}

const { theme = 'vermillion', class: className = '' } = Astro.props;

const gradients: Record<string, [string, string]> = {
  vermillion: ['#f0a89b', '#e0806f'],
  indigo: ['#a9d2e6', '#6fa8c9'],
  gold: ['#ecd2a0', '#ddb877'],
};

const [from, to] = gradients[theme];
const gradientId = `torii-grad-${theme}`;
---

<svg
  viewBox="0 0 400 240"
  class={`h-full w-full ${className}`}
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="鳥居のイラスト"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={from} />
      <stop offset="100%" stop-color={to} />
    </linearGradient>
  </defs>
  <rect width="400" height="240" fill={`url(#${gradientId})`} />
  <circle cx="330" cy="55" r="28" fill="#fdf8f1" opacity="0.25" />
  <g stroke="#fdf8f1" stroke-width="7" stroke-linecap="round" opacity="0.92">
    <line x1="90" y1="70" x2="80" y2="200" />
    <line x1="310" y1="70" x2="320" y2="200" />
    <line x1="70" y1="80" x2="330" y2="80" />
    <line x1="80" y1="80" x2="70" y2="95" />
    <line x1="320" y1="80" x2="330" y2="95" />
    <line x1="105" y1="115" x2="295" y2="115" stroke-width="5" />
  </g>
</svg>
