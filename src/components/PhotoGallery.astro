---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  image: ImageMetadata;
  alt: string;
  credit?: { author: string; license: string; sourceUrl: string };
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

const fullImages = await Promise.all(
  photos.map((photo) => getImage({ src: photo.image, width: 1400, format: 'webp' })),
);

const lightboxData = photos.map((photo, i) => ({
  src: fullImages[i].src,
  alt: photo.alt,
  credit: photo.credit ?? null,
}));

type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: {
    heading: '写真',
    zoomAlt: (alt: string) => `${alt}を拡大表示`,
    dialogLabel: '写真拡大表示',
    close: '閉じる',
    prev: '前の写真',
    next: '次の写真',
    creditPrefix: '写真:',
  },
  en: {
    heading: 'Photos',
    zoomAlt: (alt: string) => `View ${alt} larger`,
    dialogLabel: 'Photo viewer',
    close: 'Close',
    prev: 'Previous photo',
    next: 'Next photo',
    creditPrefix: 'Photo:',
  },
  zh: {
    heading: '照片',
    zoomAlt: (alt: string) => `放大檢視${alt}`,
    dialogLabel: '照片檢視器',
    close: '關閉',
    prev: '上一張照片',
    next: '下一張照片',
    creditPrefix: '照片來源：',
  },
  es: {
    heading: 'Fotos',
    zoomAlt: (alt: string) => `Ver ${alt} en grande`,
    dialogLabel: 'Visor de fotos',
    close: 'Cerrar',
    prev: 'Foto anterior',
    next: 'Foto siguiente',
    creditPrefix: 'Foto:',
  },
  fr: {
    heading: 'Photos',
    zoomAlt: (alt: string) => `Agrandir ${alt}`,
    dialogLabel: 'Visionneuse de photos',
    close: 'Fermer',
    prev: 'Photo précédente',
    next: 'Photo suivante',
    creditPrefix: 'Photo :',
  },
  ko: {
    heading: '사진',
    zoomAlt: (alt: string) => `${alt} 크게 보기`,
    dialogLabel: '사진 뷰어',
    close: '닫기',
    prev: '이전 사진',
    next: '다음 사진',
    creditPrefix: '사진:',
  },
}[lang];
---

{photos.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6">
    <h2 class="font-serif-jp text-lg font-bold text-shrine-ink sm:text-xl">{t.heading}</h2>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {photos.map((photo, i) => (
        <button
          type="button"
          class="gallery-thumb group relative aspect-[4/3] overflow-hidden rounded-2xl border border-shrine-gold/20"
          data-index={i}
          aria-label={t.zoomAlt(photo.alt)}
        >
          <Image
            src={photo.image}
            alt={photo.alt}
            width={480}
            height={360}
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
          />
        </button>
      ))}
    </div>
  </section>
)}

<div
  id="gallery-lightbox"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-black/90 p-4"
  role="dialog"
  aria-modal="true"
  aria-label={t.dialogLabel}
>
  <button id="gallery-close" type="button" aria-label={t.close} class="absolute right-4 top-4 text-3xl text-white/80 transition hover:text-white">
    &times;
  </button>
  <button id="gallery-prev" type="button" aria-label={t.prev} class="absolute left-2 text-4xl text-white/70 transition hover:text-white sm:left-6">
    &lsaquo;
  </button>
  <button id="gallery-next" type="button" aria-label={t.next} class="absolute right-2 text-4xl text-white/70 transition hover:text-white sm:right-6">
    &rsaquo;
  </button>
  <figure class="max-w-[90vw]">
    <img id="gallery-image" src="" alt="" class="max-h-[75vh] max-w-[90vw] rounded object-contain" />
    <figcaption id="gallery-caption" class="mt-3 text-center text-xs text-white/70"></figcaption>
  </figure>
</div>

<script define:vars={{ lightboxData, creditPrefix: t.creditPrefix }}>
  const lightbox = document.getElementById('gallery-lightbox');
  const imgEl = document.getElementById('gallery-image');
  const captionEl = document.getElementById('gallery-caption');
  const closeBtn = document.getElementById('gallery-close');
  const prevBtn = document.getElementById('gallery-prev');
  const nextBtn = document.getElementById('gallery-next');
  const thumbs = document.querySelectorAll('.gallery-thumb');
  let current = 0;

  function captionFor(item) {
    if (!item.credit) return '';
    return `${creditPrefix} ${item.credit.author} / ${item.credit.license}`;
  }

  function openAt(index) {
    current = index;
    const item = lightboxData[current];
    imgEl.src = item.src;
    imgEl.alt = item.alt;
    captionEl.textContent = captionFor(item);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  function shift(delta) {
    openAt((current + delta + lightboxData.length) % lightboxData.length);
  }

  if (lightboxData.length <= 1) {
    prevBtn.classList.add('hidden');
    nextBtn.classList.add('hidden');
  }

  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => openAt(Number(btn.dataset.index)));
  });
  closeBtn.addEventListener('click', closeLightbox);
  prevBtn.addEventListener('click', () => shift(-1));
  nextBtn.addEventListener('click', () => shift(1));
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') shift(-1);
    if (e.key === 'ArrowRight') shift(1);
  });
</script>
