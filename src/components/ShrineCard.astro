---
import { Image } from 'astro:assets';
import ToriiArt from './ToriiArt.astro';
import FavoriteButton from './FavoriteButton.astro';
import type { CollectionEntry } from 'astro:content';
import { benefitTranslations } from '../data/benefitTranslations';
import { benefitTranslationsZh } from '../data/benefitTranslationsZh';
import { benefitTranslationsEs } from '../data/benefitTranslationsEs';
import { benefitTranslationsFr } from '../data/benefitTranslationsFr';
import { benefitTranslationsKo } from '../data/benefitTranslationsKo';
import { buildAmazonSearchUrl } from '../data/affiliate';
import { buildAccommodationBookingUrl, buildAccommodationRakutenUrl } from '../lib/accommodation';
import { cardText, prepKeywords } from '../data/monetization';

interface Props {
  shrine: CollectionEntry<'shrines' | 'shrinesEn' | 'shrinesZh' | 'shrinesEs' | 'shrinesFr' | 'shrinesKo'>;
}

const { shrine } = Astro.props;
const { id, data } = shrine;
const tags = [...(data.benefits ?? [])].slice(0, 3);

type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const base = lang === 'ja' ? '' : `/${lang}`;

const benefitTranslationsByLang: Partial<Record<Lang, Record<string, string>>> = {
  en: benefitTranslations,
  zh: benefitTranslationsZh,
  es: benefitTranslationsEs,
  fr: benefitTranslationsFr,
  ko: benefitTranslationsKo,
};
const translateBenefit = (tag: string) => benefitTranslationsByLang[lang]?.[tag] ?? tag;

const locationSeparator: Record<Lang, string> = { ja: '・', en: ', ', zh: '、', es: ', ', fr: ', ', ko: '・' };

// 一覧から直接、宿泊・御朱印帳へ（日本語版は楽天トラベル、それ以外はBooking.com）
const accommodationInput = { city: data.city, prefecture: data.prefecture, bookingCity: data.bookingCity, bookingPrefecture: data.bookingPrefecture };
const hotelUrl = lang === 'ja'
  ? buildAccommodationRakutenUrl(data.name, accommodationInput)
  : buildAccommodationBookingUrl(lang, accommodationInput);
const goshuinUrl = buildAmazonSearchUrl(prepKeywords.goshuincho, lang);
---

<div class="group relative flex flex-col overflow-hidden rounded-2xl border border-shrine-gold/25 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
<a
  href={`${base}/shrines/${id}/`}
  class="block flex-1 after:absolute after:inset-0 after:content-['']"
>
  <div class="relative h-40 overflow-hidden">
    <div class="absolute right-2 top-2 z-10">
      <FavoriteButton shrineId={id} />
    </div>
    {data.image ? (
      <Image
        src={data.image}
        alt={data.name}
        width={480}
        height={320}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
    ) : (
      <ToriiArt theme={data.themeColor} class="transition duration-500 group-hover:scale-105" />
    )}
  </div>
  <div class="p-5">
    <p class="text-xs font-medium tracking-wide text-shrine-vermillion">{data.prefecture}{locationSeparator[lang]}{data.city}</p>
    <h3 class="mt-1 font-serif-jp text-lg font-bold text-shrine-ink">{data.name}</h3>
    <p class="mt-1 text-xs text-shrine-ink-soft">{data.kana}</p>
    {tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded-full bg-shrine-vermillion-light px-2.5 py-0.5 text-xs text-shrine-vermillion-dark">
            {translateBenefit(tag)}
          </li>
        ))}
      </ul>
    )}
  </div>
</a>
  <div class="relative z-10 flex flex-wrap items-center gap-2 border-t border-shrine-gold/15 px-5 py-3 text-xs">
    <span class="rounded bg-shrine-paper-dark px-1.5 py-0.5 text-[10px] font-bold text-shrine-ink-soft">{cardText.pr}</span>
    <a href={hotelUrl} target="_blank" rel="noopener noreferrer sponsored" class="text-shrine-vermillion hover:underline">🏨 {cardText.hotel[lang]}</a>
    <a href={goshuinUrl} target="_blank" rel="nofollow sponsored noopener" class="text-shrine-vermillion hover:underline">📕 {cardText.goshuincho[lang]}</a>
  </div>
</div>
