---
// AdSense の広告枠（手動配置）。adsenseEnabled が false、または枠の slot ID が空なら何も出力しない。
import { adsenseClient, adsenseEnabled, adsenseSlots, adLabel, type AdPlacement } from '../data/adsense';

interface Props {
  placement: AdPlacement;
}

type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const { placement } = Astro.props;
const slot = adsenseSlots[placement];
const show = adsenseEnabled && !!slot;
---

{show && (
  <aside class="my-10" aria-label={adLabel[lang]}>
    <p class="mb-1 text-center text-[10px] tracking-wide text-shrine-ink-soft">{adLabel[lang]}</p>
    <div class="min-h-[250px]">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={adsenseClient}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    </div>
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
)}
