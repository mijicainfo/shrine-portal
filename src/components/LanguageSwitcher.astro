---
import { availableLangs } from '../lib/content';

const path = Astro.url.pathname;
const locales = ['en', 'zh', 'es', 'fr', 'ko'] as const;
type Locale = 'ja' | (typeof locales)[number];

const matched = locales.find((l) => path === `/${l}` || path.startsWith(`/${l}/`));
const currentLang: Locale = matched ?? 'ja';

const localePattern = new RegExp(`^/(${locales.join('|')})`);
const basePath = currentLang === 'ja' ? path : path.replace(localePattern, '') || '/';
// Scheduled publishing: a shrine/guide page may not be live in every language yet
// (see src/lib/content.ts). For a language where this page isn't released, link to
// that language's shrine/guide list instead of a page that doesn't exist.
const liveLangs = await availableLangs(basePath);
const listPath = basePath.startsWith('/guides/') ? '/guides/' : '/shrines/';
const buildPath = (lang: Locale) => {
  const target = liveLangs.includes(lang) ? basePath : listPath;
  return lang === 'ja' ? target : `/${lang}${target === '/' ? '' : target}`;
};

const links = [
  { lang: 'ja' as const, label: '日本語' },
  { lang: 'en' as const, label: 'EN' },
  { lang: 'zh' as const, label: '繁體中文' },
  { lang: 'es' as const, label: 'ES' },
  { lang: 'fr' as const, label: 'FR' },
  { lang: 'ko' as const, label: '한국어' },
];
---

<div class="flex flex-wrap items-center gap-1 rounded-full border border-shrine-gold/30 p-0.5 text-xs">
  {links.map((link) => (
    <a
      href={buildPath(link.lang)}
      class={`rounded-full px-2.5 py-1 transition ${currentLang === link.lang ? 'bg-shrine-vermillion text-white' : 'text-shrine-ink-soft hover:text-shrine-vermillion'}`}
    >
      {link.label}
    </a>
  ))}
</div>
