---
import OfudaCard from './OfudaCard.astro';

type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: {
    threeGate: '三社造の場合（お札を並べて飾る）',
    sukeiLabel: '崇敬神社',
    sukeiSub: '（向かって左）',
    jinguLabel: '神宮大麻',
    jinguSub: '（中央）',
    ujiLabel: '氏神様',
    ujiSub: '（向かって右）',
    oneGate: '一社造の場合（お札を重ねて飾る）',
    stackHint: '手前から見て、この順番に重ねます',
    stackLegend: ['① 神宮大麻（一番手前）', '② 氏神様（2番目）', '③ 崇敬神社（一番奥）'],
  },
  en: {
    threeGate: 'Three-Door Style (Sansha-zukuri) — side by side',
    sukeiLabel: 'Personal Shrine',
    sukeiSub: '(left)',
    jinguLabel: 'Jingu Taima',
    jinguSub: '(center)',
    ujiLabel: "Local Shrine's",
    ujiSub: '(right)',
    oneGate: 'One-Door Style (Issha-zukuri) — stacked',
    stackHint: 'Stack them in this order, front to back',
    stackLegend: ['① Jingu Taima (front)', '② Local Shrine (2nd)', '③ Personal Shrine (back)'],
  },
  zh: {
    threeGate: '三社造（三扇門）— 並排供奉',
    sukeiLabel: '崇敬神社',
    sukeiSub: '（面向左側）',
    jinguLabel: '神宮大麻',
    jinguSub: '（中央）',
    ujiLabel: '氏神',
    ujiSub: '（面向右側）',
    oneGate: '一社造（單扇門）— 疊放供奉',
    stackHint: '由前往後，依此順序疊放',
    stackLegend: ['① 神宮大麻（最前）', '② 氏神（第二）', '③ 崇敬神社（最後）'],
  },
  es: {
    threeGate: 'Estilo de Tres Puertas (Sansha-zukuri) — en fila',
    sukeiLabel: 'Santuario Personal',
    sukeiSub: '(izquierda)',
    jinguLabel: 'Jingu Taima',
    jinguSub: '(centro)',
    ujiLabel: 'Santuario Local',
    ujiSub: '(derecha)',
    oneGate: 'Estilo de Una Puerta (Issha-zukuri) — apilados',
    stackHint: 'Apílalos en este orden, de adelante hacia atrás',
    stackLegend: ['① Jingu Taima (delante)', '② Santuario Local (2º)', '③ Santuario Personal (atrás)'],
  },
  fr: {
    threeGate: 'Style à Trois Portes (Sansha-zukuri) — côte à côte',
    sukeiLabel: 'Sanctuaire Personnel',
    sukeiSub: '(à gauche)',
    jinguLabel: 'Jingu Taima',
    jinguSub: '(au centre)',
    ujiLabel: 'Sanctuaire Local',
    ujiSub: '(à droite)',
    oneGate: 'Style à Une Porte (Issha-zukuri) — empilés',
    stackHint: 'Empilez-les dans cet ordre, de l’avant vers l’arrière',
    stackLegend: ['① Jingu Taima (devant)', '② Sanctuaire Local (2e)', '③ Sanctuaire Personnel (arrière)'],
  },
  ko: {
    threeGate: '삼사조(三社造, 세 개의 문) — 나란히 모시는 경우',
    sukeiLabel: '숭경신사',
    sukeiSub: '(왼쪽)',
    jinguLabel: '진구타이마',
    jinguSub: '(중앙)',
    ujiLabel: '우지가미',
    ujiSub: '(오른쪽)',
    oneGate: '잇샤즈쿠리(一社造, 한 개의 문) — 겹쳐 모시는 경우',
    stackHint: '앞에서부터 이 순서로 겹쳐 놓습니다',
    stackLegend: ['① 진구타이마 (맨 앞)', '② 우지가미 (두 번째)', '③ 숭경신사 (맨 뒤)'],
  },
}[lang];

const sukeiAccent = '#4d84a3';
const jinguAccent = '#d16a5c';
const ujiAccent = '#c49a5c';
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
  <div class="rounded-2xl border border-shrine-gold/25 bg-white p-5">
    <p class="text-center text-xs font-bold text-shrine-ink-soft">{t.threeGate}</p>
    <div class="mt-5 flex items-end justify-center gap-3">
      <div class="text-center">
        <OfudaCard accent={sukeiAccent} class="mx-auto h-16 w-11 drop-shadow" />
        <p class="mt-1.5 text-[11px] font-bold text-shrine-ink">{t.sukeiLabel}</p>
        <p class="text-[10px] text-shrine-ink-soft">{t.sukeiSub}</p>
      </div>
      <div class="text-center">
        <OfudaCard accent={jinguAccent} class="mx-auto h-20 w-14 drop-shadow-md" />
        <p class="mt-1.5 text-[11px] font-bold text-shrine-ink">{t.jinguLabel}</p>
        <p class="text-[10px] text-shrine-ink-soft">{t.jinguSub}</p>
      </div>
      <div class="text-center">
        <OfudaCard accent={ujiAccent} class="mx-auto h-16 w-11 drop-shadow" />
        <p class="mt-1.5 text-[11px] font-bold text-shrine-ink">{t.ujiLabel}</p>
        <p class="text-[10px] text-shrine-ink-soft">{t.ujiSub}</p>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-shrine-gold/25 bg-white p-5">
    <p class="text-center text-xs font-bold text-shrine-ink-soft">{t.oneGate}</p>
    <div class="relative mx-auto mt-5 h-24" style="width: 116px;">
      <div class="absolute" style="left: 0px; top: 16px;">
        <OfudaCard accent={sukeiAccent} class="h-20 w-14 drop-shadow" />
        <span
          class="absolute flex h-5 w-5 items-center justify-center rounded-full bg-shrine-ink text-[10px] font-bold text-white shadow"
          style="left: -8px; top: -8px;"
        >3</span>
      </div>
      <div class="absolute" style="left: 22px; top: 8px;">
        <OfudaCard accent={ujiAccent} class="h-20 w-14 drop-shadow" />
        <span
          class="absolute flex h-5 w-5 items-center justify-center rounded-full bg-shrine-ink text-[10px] font-bold text-white shadow"
          style="left: -8px; top: -8px;"
        >2</span>
      </div>
      <div class="absolute" style="left: 44px; top: 0px;">
        <OfudaCard accent={jinguAccent} class="h-20 w-14 drop-shadow-lg" />
        <span
          class="absolute flex h-5 w-5 items-center justify-center rounded-full bg-shrine-vermillion-dark text-[10px] font-bold text-white shadow"
          style="left: -8px; top: -8px;"
        >1</span>
      </div>
    </div>
    <p class="mt-3 text-center text-[11px] text-shrine-ink-soft">{t.stackHint}</p>
    <ul class="mx-auto mt-2 max-w-[220px] space-y-1 text-[11px] leading-relaxed text-shrine-ink">
      {t.stackLegend.map((line) => <li>{line}</li>)}
    </ul>
  </div>
</div>
