---
type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const t = {
  ja: {
    threeGate: '三社造の場合',
    sukeiLabel: '崇敬神社',
    sukeiSub: '（向かって左）',
    jinguLabel: '神宮大麻',
    jinguSub: '（中央）',
    ujiLabel: '氏神様',
    ujiSub: '（向かって右）',
    oneGate: '一社造の場合（重ねる順）',
    stackOrder: '手前：神宮大麻 → 2番目：氏神様 → 奥：崇敬神社',
  },
  en: {
    threeGate: 'Three-Door Style (Sansha-zukuri)',
    sukeiLabel: 'Personal Shrine',
    sukeiSub: '(left)',
    jinguLabel: 'Jingu Taima',
    jinguSub: '(center)',
    ujiLabel: "Local Shrine's",
    ujiSub: '(right)',
    oneGate: 'One-Door Style (Issha-zukuri), Stacking Order',
    stackOrder: 'Front: Jingu Taima → 2nd: Local Shrine → Back: Personal Shrine',
  },
  zh: {
    threeGate: '三社造（三扇門）的情況',
    sukeiLabel: '崇敬神社',
    sukeiSub: '（面向左側）',
    jinguLabel: '神宮大麻',
    jinguSub: '（中央）',
    ujiLabel: '氏神',
    ujiSub: '（面向右側）',
    oneGate: '一社造（單扇門）的情況（疊放順序）',
    stackOrder: '最前：神宮大麻 → 第二：氏神 → 最後：崇敬神社',
  },
  es: {
    threeGate: 'Estilo de Tres Puertas (Sansha-zukuri)',
    sukeiLabel: 'Santuario Personal',
    sukeiSub: '(izquierda)',
    jinguLabel: 'Jingu Taima',
    jinguSub: '(centro)',
    ujiLabel: 'Santuario Local',
    ujiSub: '(derecha)',
    oneGate: 'Estilo de Una Puerta (Issha-zukuri), Orden de Apilado',
    stackOrder: 'Frente: Jingu Taima → 2º: Santuario Local → Atrás: Santuario Personal',
  },
  fr: {
    threeGate: 'Style à Trois Portes (Sansha-zukuri)',
    sukeiLabel: 'Sanctuaire Personnel',
    sukeiSub: '(à gauche)',
    jinguLabel: 'Jingu Taima',
    jinguSub: '(au centre)',
    ujiLabel: 'Sanctuaire Local',
    ujiSub: '(à droite)',
    oneGate: 'Style à Une Porte (Issha-zukuri), Ordre d’Empilement',
    stackOrder: 'Devant : Jingu Taima → 2e : Sanctuaire Local → Arrière : Sanctuaire Personnel',
  },
  ko: {
    threeGate: '삼사조(三社造, 세 개의 문)의 경우',
    sukeiLabel: '숭경신사',
    sukeiSub: '(왼쪽)',
    jinguLabel: '진구타이마',
    jinguSub: '(중앙)',
    ujiLabel: '우지가미',
    ujiSub: '(오른쪽)',
    oneGate: '잇샤즈쿠리(一社造, 한 개의 문)의 경우 (쌓는 순서)',
    stackOrder: '앞: 진구타이마 → 두 번째: 우지가미 → 뒤: 숭경신사',
  },
}[lang];
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
  <div class="rounded-2xl border border-shrine-gold/25 bg-white p-5">
    <p class="text-center text-xs font-bold text-shrine-ink-soft">{t.threeGate}</p>
    <div class="mt-5 flex items-end justify-center gap-3">
      <div class="text-center">
        <div class="flex h-16 w-14 items-center justify-center rounded bg-gradient-to-br from-shrine-indigo to-shrine-indigo-dark text-xl text-white shadow">⛩</div>
        <p class="mt-1.5 text-[11px] font-bold text-shrine-ink">{t.sukeiLabel}</p>
        <p class="text-[10px] text-shrine-ink-soft">{t.sukeiSub}</p>
      </div>
      <div class="text-center">
        <div class="flex h-20 w-16 items-center justify-center rounded bg-gradient-to-br from-shrine-vermillion to-shrine-vermillion-dark text-2xl text-white shadow-lg">⛩</div>
        <p class="mt-1.5 text-[11px] font-bold text-shrine-ink">{t.jinguLabel}</p>
        <p class="text-[10px] text-shrine-ink-soft">{t.jinguSub}</p>
      </div>
      <div class="text-center">
        <div class="flex h-16 w-14 items-center justify-center rounded bg-gradient-to-br from-shrine-gold to-[#7a5f38] text-xl text-white shadow">⛩</div>
        <p class="mt-1.5 text-[11px] font-bold text-shrine-ink">{t.ujiLabel}</p>
        <p class="text-[10px] text-shrine-ink-soft">{t.ujiSub}</p>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-shrine-gold/25 bg-white p-5">
    <p class="text-center text-xs font-bold text-shrine-ink-soft">{t.oneGate}</p>
    <div class="relative mt-5 flex h-24 items-end justify-center">
      <div class="absolute h-20 w-24 translate-x-3 translate-y-3 rounded bg-shrine-indigo/30"></div>
      <div class="absolute h-20 w-24 translate-x-1.5 translate-y-1.5 rounded bg-shrine-gold/40"></div>
      <div class="relative flex h-20 w-24 items-center justify-center rounded bg-gradient-to-br from-shrine-vermillion to-shrine-vermillion-dark text-2xl text-white shadow-lg">⛩</div>
    </div>
    <p class="mt-3 text-center text-[11px] leading-relaxed text-shrine-ink-soft">
      {t.stackOrder}
    </p>
  </div>
</div>
