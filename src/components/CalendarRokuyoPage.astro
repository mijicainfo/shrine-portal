---
// 六曜カレンダー（参考ページ）（/calendar/2027/rokuyo/）。各言語の src/pages/**/calendar/2027/rokuyo.astro から使う。
import Layout from '../layouts/Layout.astro';
import CalendarGrid from './CalendarGrid.astro';
import CalendarNotice from './CalendarNotice.astro';
import { calendarText } from '../data/calendarText';
import { rokuyoKanji } from '../lib/calendarStyle';
import { MONTHS } from '../lib/calendar';

type Lang = 'ja' | 'en' | 'zh' | 'es' | 'fr' | 'ko';
const supportedLangs: Lang[] = ['en', 'zh', 'es', 'fr', 'ko'];
const lang: Lang = supportedLangs.includes(Astro.currentLocale as Lang) ? (Astro.currentLocale as Lang) : 'ja';
const base = lang === 'ja' ? '' : `/${lang}`;
const t = calendarText[lang];
const p = t.ui.rokuyoPage;
const keys = Object.keys(rokuyoKanji) as (keyof typeof rokuyoKanji)[];
---

<Layout title={p.title} description={p.description}>
  <section class="bg-shrine-indigo-dark py-14 text-shrine-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs text-shrine-paper/70">
        <a href={`${base}/calendar/2027/`} class="underline hover:text-white">{p.backToYear}</a>
        <span class="ml-2 inline-block rounded-full border border-shrine-paper/40 px-2 py-0.5 text-[10px]">{p.noteBadge}</span>
      </p>
      <h1 class="mt-2 font-serif-jp text-2xl font-bold sm:text-3xl">{p.h1}</h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-shrine-paper/85">{p.lead}</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl space-y-10 px-4 py-10 sm:px-6">
    <section aria-labelledby="rokuyo-about" class="rounded-2xl border border-shrine-gold/25 bg-white p-5 shadow-sm">
      <h2 id="rokuyo-about" class="font-serif-jp text-lg font-bold text-shrine-ink">{p.aboutHeading}</h2>
      {p.aboutBody.map((para) => <p class="mt-2 text-sm leading-relaxed text-shrine-ink">{para}</p>)}
      <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
        {keys.map((k) => (
          <li class="text-sm text-shrine-ink">
            <span class="font-bold">{t.rokuyo[k].name}</span>
            <span class="block text-xs leading-relaxed text-shrine-ink-soft">{t.rokuyo[k].desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="rokuyo-table">
      <h2 id="rokuyo-table" class="font-serif-jp text-xl font-bold text-shrine-ink">{p.tableHeading}</h2>
      <p class="mt-1 text-xs text-shrine-ink-soft">{p.calcNote}</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {MONTHS.map((m) => <CalendarGrid month={m} lang={lang} mode="rokuyo" compact />)}
      </div>
    </section>

    <CalendarNotice lang={lang} />
  </div>
</Layout>
